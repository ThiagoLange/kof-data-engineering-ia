// modulo-02-dataframe/05-web-charts/lab.kof
// Gráficos para a web: SVG server-side + Canvas KofJS client-side, servido via File + kof serve/web.
// Reusa 02-03 scatter/bar e 02-04 HTML, agora como dashboard.html com 2 SVGs + <canvas> JS.
// Target: JVM 0.4.10 (File OK em todos targets, kof.web é JVM-only mas dashboard é estático).
split(String s, String delim): List<String> { var out=listOf<String>(); var start=0; var n=s.length; var i=0; while(i<n){ if(s.charAt(i)==delim.charAt(0)){ out.add(s.substring(start,i)); start=i+1 } i=i+1 } out.add(s.substring(start,n)); return out }
trim(String s): String { var n=s.length; var start=0; while(start<n){ var c=s.charAt(start); if(c!=32&&c!=9&&c!=10&&c!=13){break} start=start+1 } var end=n; while(end>start){ var c=s.charAt(end-1); if(c!=32&&c!=9&&c!=10&&c!=13){break} end=end-1 } return s.substring(start,end) }
parseFloatStrict(String s): Double { if(s==null){throw "parseFloat: null"} var n=s.length; if(n==0){throw "parseFloat: empty"} var i=0; var sign=1.0; var c=s.charAt(0); if(c==45){sign=-1.0; i=1} var intPart=0.0; while(i<n){ var ch=s.charAt(i); if(ch>=48&&ch<=57){intPart=intPart*10.0+ch-48.0; i=i+1} else{break} } var base=sign*intPart; var fracAcc=0.0; var div=1.0; var hasDot=0; if(i<n&&s.charAt(i)==46){hasDot=1; i=i+1} while(i<n&&hasDot==1){ var ch=s.charAt(i); if(ch>=48&&ch<=57){fracAcc=fracAcc*10.0+ch-48.0; div=div*10.0; i=i+1} else{break} } var frac=fracAcc/div; if(sign<0.0){frac=-frac} return base+frac }
minD(List<Double> xs): Double { if(xs.size()==0){throw "min: empty"} var m=xs.get(0); var i=1; while(i<xs.size()){ if(xs.get(i)<m){m=xs.get(i)} i=i+1 } return m }
maxD(List<Double> xs): Double { if(xs.size()==0){throw "max: empty"} var m=xs.get(0); var i=1; while(i<xs.size()){ if(xs.get(i)>m){m=xs.get(i)} i=i+1 } return m }
record IrisRow(Double sepal_length, Double petal_length, String species)
record Bar(String label, Double value)
record Customer(Int customer_id, String name, String city)
record Transaction(Int tx_id, Int customer_id, Double amount)
loadIris(String p): List<IrisRow> { var raw=File(p).readText(); if(raw==null){throw "iris: cannot read "+p} var lines=split(raw,"\n"); var out=listOf<IrisRow>(); var i=1; while(i<lines.size()){ var l=trim(lines.get(i)); if(l.length>0){ var c=split(l,","); out.add(IrisRow(parseFloatStrict(trim(c.get(0))), parseFloatStrict(trim(c.get(2))), trim(c.get(4)))) } i=i+1 } return out }
loadCustomers(String p): List<Customer> { var raw=File(p).readText(); if(raw==null){throw "customers: cannot read "+p} var lines=split(raw,"\n"); var out=listOf<Customer>(); var i=0; while(i<lines.size()){ var l=trim(lines.get(i)); if(l.length>0){out.add(json.decode<Customer>(l))} i=i+1 } return out }
loadTransactions(String p): List<Transaction> { var raw=File(p).readText(); if(raw==null){throw "tx: cannot read "+p} var lines=split(raw,"\n"); var out=listOf<Transaction>(); var i=0; while(i<lines.size()){ var l=trim(lines.get(i)); if(l.length>0){out.add(json.decode<Transaction>(l))} i=i+1 } return out }
colorForSpecies(String s): String { if(s=="setosa"){return "#e41a1c"} if(s=="versicolor"){return "#377eb8"} return "#4daf4a" }
mapX(Double v, Double dMin, Double dMax, Double pMin, Double pMax): Double { if(dMax==dMin){return pMin} var t=(v-dMin)/(dMax-dMin); return pMin+t*(pMax-pMin) }
mapY(Double v, Double dMin, Double dMax, Double pMin, Double pMax): Double { if(dMax==dMin){return pMin} var t=(v-dMin)/(dMax-dMin); return pMax-t*(pMax-pMin) }
scatterSvg(List<IrisRow> rows, Int w, Int h): String { var xs=listOf<Double>(); var ys=listOf<Double>(); var i=0; while(i<rows.size()){ xs.add(rows.get(i).sepal_length); ys.add(rows.get(i).petal_length); i=i+1 } var xMin=minD(xs); var xMax=maxD(xs); var yMin=minD(ys); var yMax=maxD(ys); var pad=40.0; var wf=1.0*w; var hf=1.0*h; var sb=""; sb=sb+"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\""+w.toString()+"\" height=\""+h.toString()+"\"><rect width=\"100%\" height=\"100%\" fill=\"white\"/><line x1=\""+pad.toString()+"\" y1=\""+(hf-pad).toString()+"\" x2=\""+(wf-pad).toString()+"\" y2=\""+(hf-pad).toString()+"\" stroke=\"black\"/><line x1=\""+pad.toString()+"\" y1=\""+pad.toString()+"\" x2=\""+pad.toString()+"\" y2=\""+(hf-pad).toString()+"\" stroke=\"black\"/>"; var j=0; while(j<rows.size()){ var r=rows.get(j); var px=mapX(r.sepal_length,xMin,xMax,pad,wf-pad); var py=mapY(r.petal_length,yMin,yMax,pad,hf-pad); sb=sb+"<circle cx=\""+px.toString()+"\" cy=\""+py.toString()+"\" r=\"5\" fill=\""+colorForSpecies(r.species)+"\" opacity=\"0.8\"/>"; j=j+1 } sb=sb+"</svg>"; return sb }
barSvg(List<Bar> bars, Int w, Int h): String { var vals=listOf<Double>(); var i=0; while(i<bars.size()){ vals.add(bars.get(i).value); i=i+1 } var vMax=maxD(vals); if(vMax==0.0){vMax=1.0} var pad=40.0; var wf=1.0*w; var hf=1.0*h; var n=bars.size(); var nf=1.0*n; var slot=(wf-2.0*pad)/nf; var barW=slot*0.6; var gap=slot*0.4; var sb=""; sb=sb+"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\""+w.toString()+"\" height=\""+h.toString()+"\"><rect width=\"100%\" height=\"100%\" fill=\"white\"/>"; var j=0; while(j<n){ var b=bars.get(j); var jf=1.0*j; var x=pad+jf*slot+gap/2.0; var bh=(b.value/vMax)*(hf-2.0*pad); var y=hf-pad-bh; sb=sb+"<rect x=\""+x.toString()+"\" y=\""+y.toString()+"\" width=\""+barW.toString()+"\" height=\""+bh.toString()+"\" fill=\"#377eb8\"/><text x=\""+(x+barW/2.0).toString()+"\" y=\""+(hf-20.0).toString()+"\" text-anchor=\"middle\" font-size=\"11\">"+b.label+"</text>"; j=j+1 } sb=sb+"</svg>"; return sb }
countByCity(List<Transaction> txs, List<Customer> cs): List<Bar> { var names=listOf<String>(); var counts=listOf<Double>(); var i=0; while(i<txs.size()){ var t=txs.get(i); var city=""; var j=0; while(j<cs.size()){ if(cs.get(j).customer_id==t.customer_id){city=cs.get(j).city; j=cs.size()} else{j=j+1} } var idx=-1; var k=0; while(k<names.size()){ if(names.get(k)==city){idx=k; k=names.size()} else{k=k+1} } if(idx==-1){ names.add(city); counts.add(1.0) } else{ counts.set(idx, counts.get(idx)+1.0) } i=i+1 } var out=listOf<Bar>(); var b=0; while(b<names.size()){ out.add(Bar(names.get(b),counts.get(b))); b=b+1 } return out }
dashboardHtml(String scatter, String bars, List<Bar> barData): String { var jsData="["; var i=0; while(i<barData.size()){ if(i>0){jsData=jsData+","} jsData=jsData+"{city:\""+barData.get(i).label+"\",total:"+barData.get(i).value.toString()+"}"; i=i+1 } var html=""; html=html+"<!DOCTYPE html><html><head><meta charset=\"UTF-8\"/><title>Kof Web Dashboard</title><style>body{font-family:sans-serif;margin:24px} .grid{display:grid;grid-template-columns:1fr 1fr;gap:24px} canvas{border:1px solid #ccc}</style></head><body>\n"; html=html+"<h1>Iris & Transactions Dashboard (Kof Web)</h1>\n"; html=html+"<div class=\"grid\"><div><h2>Scatter (SVG server-side)</h2>"+scatter+"</div><div><h2>Bars (SVG server-side)</h2>"+bars+"</div></div>\n"; html=html+"<h2>Bars (Canvas KofJS client-side)</h2><canvas id=\"chart\" width=\"400\" height=\"280\"></canvas>\n"; html=html+"<script>var data="+jsData+"; var c=document.getElementById('chart'); var ctx=c.getContext('2d'); var maxV=0; for(var i=0;i<data.length;i++){ if(data[i].total>maxV) maxV=data[i].total; } var pad=40; var w=c.width, h=c.height; var slot=(w-2*pad)/data.length; var barW=slot*0.6; ctx.strokeStyle='#000'; ctx.beginPath(); ctx.moveTo(pad,h-pad); ctx.lineTo(w-pad,h-pad); ctx.stroke(); for(var i=0;i<data.length;i++){ var bh=(data[i].total/maxV)*(h-2*pad); var x=pad+i*slot+slot*0.2; var y=h-pad-bh; ctx.fillStyle='#377eb8'; ctx.fillRect(x,y,barW,bh); ctx.fillStyle='#000'; ctx.font='11px sans-serif'; ctx.fillText(data[i].city, x+barW/2-10, h-15); }<\/script>\n"; html=html+"<p>Serve com: <code>kof serve modulo-02-dataframe/05-web-charts/</code> ou <code>kof run</code> + <code>kof build --target js</code></p>\n"; html=html+"</body></html>"; return html }
test "scatter SVG contains svg and circles" { var rows=loadIris("datasets/iris.csv"); var svg=scatterSvg(rows, 500, 350); assert(svg.contains("<svg"),"svg"); assert(svg.contains("<circle"),"circle") }
test "bar SVG contains rects" { var cs=loadCustomers("datasets/customers.jsonl"); var txs=loadTransactions("datasets/transactions.jsonl"); var bars=countByCity(txs,cs); var svg=barSvg(bars,400,280); assert(svg.contains("<rect"),"rect"); assert(svg.contains("SP"),"SP") }
test "dashboard contains canvas and svg" { var rows=loadIris("datasets/iris.csv"); var scatter=scatterSvg(rows,500,350); var cs=loadCustomers("datasets/customers.jsonl"); var txs=loadTransactions("datasets/transactions.jsonl"); var bars=countByCity(txs,cs); var html=dashboardHtml(scatter, barSvg(bars,400,280), bars); assert(html.contains("<canvas"),"canvas"); assert(html.contains("<svg"),"svg") }
test "countByCity 3 bars" { var cs=loadCustomers("datasets/customers.jsonl"); var txs=loadTransactions("datasets/transactions.jsonl"); var bars=countByCity(txs,cs); assert(bars.size()==3,"3") }
