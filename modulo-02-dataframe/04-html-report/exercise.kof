// modulo-02-dataframe/04-html-report/exercise.kof
// Run with: kof test modulo-02-dataframe/04-html-report/exercise.kof

split(String s, String delim): List<String> {
    var out = listOf<String>()
    if (delim.length == 0) { out.add(s); return out }
    var start = 0
    var n = s.length
    var i = 0
    while (i < n) { if (s.charAt(i) == delim.charAt(0)) { out.add(s.substring(start, i)); start = i + 1 } i = i + 1 }
    out.add(s.substring(start, n))
    return out
}

trim(String s): String {
    var n = s.length
    var start = 0
    while (start < n) { var c = s.charAt(start); if (c != 32 && c != 9 && c != 10 && c != 13) { break } start = start + 1 }
    var end = n
    while (end > start) { var c = s.charAt(end - 1); if (c != 32 && c != 9 && c != 10 && c != 13) { break } end = end - 1 }
    return s.substring(start, end)
}

record MetricRow(String city, Int count, Double total, Double mean)
record Customer(Int customer_id, String name, String city)
record Transaction(Int tx_id, Int customer_id, Double amount)

loadCustomers(String path): List<Customer> {
    var raw = File(path).readText()
    if (raw == null) { throw "report: cannot read " + path }
    var lines = split(raw, "\n")
    var out = listOf<Customer>()
    var i = 0
    while (i < lines.size()) { var line = trim(lines.get(i)); if (line.length > 0) { out.add(json.decode<Customer>(line)) } i = i + 1 }
    return out
}

loadTransactions(String path): List<Transaction> {
    var raw = File(path).readText()
    if (raw == null) { throw "report: cannot read " + path }
    var lines = split(raw, "\n")
    var out = listOf<Transaction>()
    var i = 0
    while (i < lines.size()) { var line = trim(lines.get(i)); if (line.length > 0) { out.add(json.decode<Transaction>(line)) } i = i + 1 }
    return out
}

computeMetrics(List<Transaction> txs, List<Customer> cs): List<MetricRow> {
    var cityNames = listOf<String>()
    var cityCounts = listOf<Int>()
    var citySums = listOf<Double>()
    var i = 0
    while (i < txs.size()) {
        var t = txs.get(i)
        var city = ""
        var j = 0
        while (j < cs.size()) { if (cs.get(j).customer_id == t.customer_id) { city = cs.get(j).city; j = cs.size() } else { j = j + 1 } }
        var idx = -1
        var k = 0
        while (k < cityNames.size()) { if (cityNames.get(k) == city) { idx = k; k = cityNames.size() } else { k = k + 1 } }
        if (idx == -1) { cityNames.add(city); cityCounts.add(1); citySums.add(t.amount) } else { cityCounts.set(idx, cityCounts.get(idx) + 1); var cur = citySums.get(idx); var nxt = cur + t.amount; citySums.set(idx, nxt) }
        i = i + 1
    }
    var out = listOf<MetricRow>()
    var b = 0
    while (b < cityNames.size()) { var cnt = cityCounts.get(b); var tot = citySums.get(b); var mu = tot / (1.0 * cnt); out.add(MetricRow(cityNames.get(b), cnt, tot, mu)); b = b + 1 }
    return out
}

htmlEscape(String s): String {
    var out = ""
    var i = 0
    while (i < s.length) { var c = s.charAt(i); if (c == 38) { out = out + "&amp;" } else if (c == 60) { out = out + "&lt;" } else if (c == 62) { out = out + "&gt;" } else { out = out + s.substring(i, i + 1) } i = i + 1 }
    return out
}

buildRows(List<MetricRow> metrics): String {
    var sb = ""
    var i = 0
    while (i < metrics.size()) { var m = metrics.get(i); sb = sb + "<tr><td>" + htmlEscape(m.city) + "</td><td>" + m.count.toString() + "</td><td>" + m.total.toString() + "</td><td>" + m.mean.toString() + "</td></tr>\n"; i = i + 1 }
    return sb
}

buildJsData(List<MetricRow> metrics): String {
    var sb = "["
    var i = 0
    while (i < metrics.size()) { var m = metrics.get(i); if (i > 0) { sb = sb + "," } sb = sb + "{city:\"" + m.city + "\",total:" + m.total.toString() + "}"; i = i + 1 }
    sb = sb + "]"
    return sb
}

buildHtml(List<MetricRow> metrics): String {
    var rows = buildRows(metrics)
    var jsData = buildJsData(metrics)
    var html = ""
    html = html + "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n"
    html = html + "<meta charset=\"UTF-8\"/>\n"
    html = html + "<title>Kof Data Report</title>\n"
    html = html + "<style>body{font-family:sans-serif;margin:24px} table{border-collapse:collapse} th,td{border:1px solid #999;padding:6px 10px} th{background:#eee}</style>\n"
    html = html + "</head>\n<body>\n"
    html = html + "<h1>Transaction Report by City</h1>\n"
    html = html + "<table>\n<thead><tr><th>City</th><th>Count</th><th>Total</th><th>Mean</th></tr></thead>\n"
    html = html + "<tbody>\n" + rows + "</tbody>\n</table>\n"
    html = html + "<h2>Totals (Canvas)</h2>\n"
    html = html + "<canvas id=\"chart\" width=\"500\" height=\"300\" style=\"border:1px solid #ccc\"></canvas>\n"
    html = html + "<script>\n"
    html = html + "var data = " + jsData + ";\n"
    html = html + "var c = document.getElementById('chart');\n"
    html = html + "var ctx = c.getContext('2d');\n"
    html = html + "var maxV = 0; for(var i=0;i<data.length;i++){ if(data[i].total>maxV) maxV=data[i].total; }\n"
    html = html + "var pad=40; var w=c.width, h=c.height;\n"
    html = html + "var slot=(w-2*pad)/data.length; var barW=slot*0.6;\n"
    html = html + "ctx.strokeStyle='#000'; ctx.beginPath(); ctx.moveTo(pad,h-pad); ctx.lineTo(w-pad,h-pad); ctx.stroke();\n"
    html = html + "for(var i=0;i<data.length;i++){\n"
    html = html + "  var bh=(data[i].total/maxV)*(h-2*pad);\n"
    html = html + "  var x=pad+i*slot+slot*0.2; var y=h-pad-bh;\n"
    html = html + "  ctx.fillStyle='#377eb8'; ctx.fillRect(x,y,barW,bh);\n"
    html = html + "}\n"
    html = html + "</script>\n"
    html = html + "</body>\n</html>\n"
    return html
}

// ─── tests ─────────────────────────────────────────────────────────────

test "computeMetrics 3 cities" {
    var cs = loadCustomers("datasets/customers.jsonl")
    var txs = loadTransactions("datasets/transactions.jsonl")
    var m = computeMetrics(txs, cs)
    assert(m.size() == 3, "3 cities got " + m.size().toString())
}

test "computeMetrics SP totals" {
    var cs = loadCustomers("datasets/customers.jsonl")
    var txs = loadTransactions("datasets/transactions.jsonl")
    var m = computeMetrics(txs, cs)
    var found = 0
    var i = 0
    while (i < m.size()) {
        if (m.get(i).city == "SP") {
            assert(m.get(i).count == 4, "SP count 4")
            var d = m.get(i).total - 1416.24
            if (d < 0.0) { d = -d }
            assert(d < 0.01, "SP total ~1416.24 got " + m.get(i).total.toString())
            found = 1
        }
        i = i + 1
    }
    assert(found == 1, "SP found")
}

test "buildHtml contains table and canvas" {
    var cs = loadCustomers("datasets/customers.jsonl")
    var txs = loadTransactions("datasets/transactions.jsonl")
    var m = computeMetrics(txs, cs)
    var html = buildHtml(m)
    assert(html.contains("<table"), "has table")
    assert(html.contains("<canvas"), "has canvas")
    assert(html.contains("var data = ["), "has js data")
    assert(html.contains("SP"), "has SP city")
}

test "buildRows escapes correctly" {
    var rows = listOf<MetricRow>()
    rows.add(MetricRow("A&B", 1, 10.0, 10.0))
    var s = buildRows(rows)
    assert(s.contains("A&amp;B"), "escaped &")
}

test "buildJsData is valid array" {
    var rows = listOf<MetricRow>()
    rows.add(MetricRow("SP", 2, 100.0, 50.0))
    var js = buildJsData(rows)
    assert(js.contains("SP"), "contains SP")
    assert(js.contains("100.0") || js.contains("100"), "contains total")
}
