// modulo-02-dataframe/01-dataframe/exercise.kof
// Run with: kof test modulo-02-dataframe/01-dataframe/exercise.kof

// ─── helpers (inline copies of shared/*.kof) ───────────────────────────

split(String s, String delim): List<String> {
    var out = listOf<String>()
    if (delim.length == 0) {
        out.add(s)
        return out
    }
    var start = 0
    var n = s.length
    var i = 0
    while (i < n) {
        if (s.charAt(i) == delim.charAt(0)) {
            out.add(s.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.add(s.substring(start, n))
    return out
}

trim(String s): String {
    var n = s.length
    var start = 0
    while (start < n) {
        var c = s.charAt(start)
        if (c != 32 && c != 9 && c != 10 && c != 13) { break }
        start = start + 1
    }
    var end = n
    while (end > start) {
        var c = s.charAt(end - 1)
        if (c != 32 && c != 9 && c != 10 && c != 13) { break }
        end = end - 1
    }
    return s.substring(start, end)
}

parseFloatStrict(String s): Double {
    if (s == null) { throw "parseFloat: null input" }
    var n = s.length
    if (n == 0) { throw "parseFloat: empty input" }
    var i = 0
    var sign = 1.0
    var c = s.charAt(0)
    if (c == 45) { sign = -1.0; i = 1 }
    else if (c == 43) { i = 1 }
    if (i >= n) { throw "parseFloat: sign only" }
    var intPart = 0.0
    var sawDigit = 0
    while (i < n) {
        var ch = s.charAt(i)
        if (ch >= 48 && ch <= 57) {
            intPart = intPart * 10.0 + ch - 48.0
            sawDigit = 1
            i = i + 1
        } else { break }
    }
    var base = sign * intPart
    var fracAcc = 0.0
    var div = 1.0
    var hasDot = 0
    if (i < n) {
        if (s.charAt(i) == 46) {
            hasDot = 1
            i = i + 1
        }
    }
    while (i < n && hasDot == 1) {
        var ch = s.charAt(i)
        if (ch >= 48 && ch <= 57) {
            fracAcc = fracAcc * 10.0 + ch - 48.0
            div = div * 10.0
            i = i + 1
        } else { break }
    }
    if (sawDigit == 0 && hasDot == 0) { throw "parseFloat: no digits" }
    if (i < n) { throw "parseFloat: trailing garbage" }
    var frac = fracAcc / div
    var value = base + frac
    return value
}

nearEq(Double a, Double b): Bool {
    var d = a - b
    if (d < 0.0) { d = -d }
    return d < 0.0001
}

minInt(Int a, Int b): Int {
    if (a < b) { return a }
    return b
}

// ─── core structures ───────────────────────────────────────────────────

record SumCount(Double sum, Double count)

class Series(String label, List<Double> values) {
    size(): Int { return values.size() }
    get(Int i): Double { return values.get(i) }
    sum(): Double {
        var s = 0.0
        var i = 0
        var n = values.size()
        while (i < n) {
            s = s + values.get(i)
            i = i + 1
        }
        return s
    }
    sumCount(): SumCount {
        var s = 0.0
        var c = 0.0
        var i = 0
        var n = values.size()
        while (i < n) {
            s = s + values.get(i)
            c = c + 1.0
            i = i + 1
        }
        return SumCount(s, c)
    }
    min(): Double {
        var n = values.size()
        if (n == 0) { throw "series: min of empty column " + label }
        var m = values.get(0)
        var i = 1
        while (i < n) {
            var v = values.get(i)
            if (v < m) { m = v }
            i = i + 1
        }
        return m
    }
    max(): Double {
        var n = values.size()
        if (n == 0) { throw "series: max of empty column " + label }
        var m = values.get(0)
        var i = 1
        while (i < n) {
            var v = values.get(i)
            if (v > m) { m = v }
            i = i + 1
        }
        return m
    }
    headRows(Int k): Series {
        var n = minInt(k, values.size())
        var out = listOf<Double>()
        var i = 0
        while (i < n) {
            out.add(values.get(i))
            i = i + 1
        }
        return Series(label, out)
    }
    tailRows(Int k): Series {
        var size = values.size()
        var n = minInt(k, size)
        var start = size - n
        var out = listOf<Double>()
        var i = start
        while (i < size) {
            out.add(values.get(i))
            i = i + 1
        }
        return Series(label, out)
    }
    maskRows(List<Int> mask): Series {
        if (mask.size() != values.size()) {
            throw "series: mask size mismatch on " + label
        }
        var out = listOf<Double>()
        var i = 0
        var n = values.size()
        while (i < n) {
            if (mask.get(i) == 1) {
                out.add(values.get(i))
            }
            i = i + 1
        }
        return Series(label, out)
    }
}

meanOf(Series s): Double {
    var sc = s.sumCount()
    return sc.sum / sc.count
}

describe(Series s): String {
    var mu = meanOf(s)
    var mn = s.min()
    var mx = s.max()
    return s.label() + " count=" + s.size().toString() +
        " mean=" + mu.toString() +
        " min=" + mn.toString() +
        " max=" + mx.toString()
}

maskGt(Series s, Double t): List<Int> {
    var out = listOf<Int>()
    var i = 0
    var n = s.size()
    while (i < n) {
        if (s.get(i) > t) {
            out.add(1)
        } else {
            out.add(0)
        }
        i = i + 1
    }
    return out
}

maskSum(List<Int> mask): Int {
    var c = 0
    var i = 0
    var n = mask.size()
    while (i < n) {
        if (mask.get(i) == 1) { c = c + 1 }
        i = i + 1
    }
    return c
}

class DataFrame(List<String> index, List<Series> cols) {
    nrows(): Int { return index.size() }
    ncols(): Int { return cols.size() }
    colAt(Int j): Series { return cols.get(j) }
    indexAt(Int i): String { return index.get(i) }
    col(String name): Series {
        var j = 0
        var m = cols.size()
        while (j < m) {
            if (cols.get(j).label() == name) {
                return cols.get(j)
            }
            j = j + 1
        }
        throw "dataframe: no column named " + name
    }
    selectRows(List<Int> keep): DataFrame {
        if (keep.size() != index.size()) {
            throw "dataframe: mask size mismatch"
        }
        var newIndex = listOf<String>()
        var i = 0
        var n = index.size()
        while (i < n) {
            if (keep.get(i) == 1) { newIndex.add(index.get(i)) }
            i = i + 1
        }
        var newCols = listOf<Series>()
        var j = 0
        var m = cols.size()
        while (j < m) {
            newCols.add(cols.get(j).maskRows(keep))
            j = j + 1
        }
        return DataFrame(newIndex, newCols)
    }
    filterMask(List<Int> mask): DataFrame {
        return selectRows(mask)
    }
    whereIndex(String value): DataFrame {
        var keep = listOf<Int>()
        var i = 0
        var n = index.size()
        while (i < n) {
            if (index.get(i) == value) {
                keep.add(1)
            } else {
                keep.add(0)
            }
            i = i + 1
        }
        return selectRows(keep)
    }
    head(Int k): DataFrame {
        var keep = listOf<Int>()
        var n = index.size()
        var lim = minInt(k, n)
        var i = 0
        while (i < n) {
            if (i < lim) { keep.add(1) } else { keep.add(0) }
            i = i + 1
        }
        return selectRows(keep)
    }
    tail(Int k): DataFrame {
        var keep = listOf<Int>()
        var n = index.size()
        var lim = minInt(k, n)
        var start = n - lim
        var i = 0
        while (i < n) {
            if (i >= start) { keep.add(1) } else { keep.add(0) }
            i = i + 1
        }
        return selectRows(keep)
    }
}

loadTable(String path): DataFrame {
    var raw = File(path).readText()
    if (raw == null) { throw "dataframe: cannot read " + path }
    var lines = split(raw, "\n")
    if (lines.size() == 0) { throw "dataframe: empty file " + path }
    var header = split(trim(lines.get(0)), ",")
    var ncolsNum = header.size() - 1
    if (ncolsNum < 1) { throw "dataframe: need at least one numeric column" }
    var colData = listOf<List<Double>>()
    var j = 0
    while (j < ncolsNum) {
        colData.add(listOf<Double>())
        j = j + 1
    }
    var index = listOf<String>()
    var i = 1
    var n = lines.size()
    while (i < n) {
        var line = trim(lines.get(i))
        if (line.length > 0) {
            var cells = split(line, ",")
            if (cells.size() != header.size()) {
                throw "dataframe: column count mismatch at line " + i.toString()
            }
            var jj = 0
            while (jj < ncolsNum) {
                colData.get(jj).add(parseFloatStrict(trim(cells.get(jj))))
                jj = jj + 1
            }
            index.add(trim(cells.get(ncolsNum)))
        }
        i = i + 1
    }
    var cols = listOf<Series>()
    j = 0
    while (j < ncolsNum) {
        cols.add(Series(trim(header.get(j)), colData.get(j)))
        j = j + 1
    }
    return DataFrame(index, cols)
}

// ─── tests ─────────────────────────────────────────────────────────────

test "dataframe loads 15 rows 4 cols" {
    var df = loadTable("datasets/iris.csv")
    assert(df.nrows() == 15, "rows")
    assert(df.ncols() == 4, "cols")
}

test "describe mean sepal_length" {
    var df = loadTable("datasets/iris.csv")
    var mu = meanOf(df.col("sepal_length"))
    var diff = mu - 5.906666
    if (diff < 0.0) { diff = -diff }
    assert(diff < 0.01, "mean sepal_length ~5.90 got " + mu.toString())
}

test "whereIndex filters setosa" {
    var df = loadTable("datasets/iris.csv")
    var s = df.whereIndex("setosa")
    assert(s.nrows() == 5, "setosa 5 rows")
}

test "maskGt filters petal_length > 5.0" {
    var df = loadTable("datasets/iris.csv")
    var pl = df.col("petal_length")
    var mask = maskGt(pl, 5.0)
    var c = maskSum(mask)
    assert(c == 5, "mask sum 5 got " + c.toString())
    var big = df.filterMask(mask)
    assert(big.nrows() == 5, "filtered 5 rows")
}

test "head and tail sizes" {
    var df = loadTable("datasets/iris.csv")
    var h = df.head(3)
    var t = df.tail(2)
    assert(h.nrows() == 3, "head 3")
    assert(t.nrows() == 2, "tail 2")
}

test "col selection throws on missing column" {
    var df = loadTable("datasets/iris.csv")
    var threw = 0
    try {
        var c = df.col("missing_col")
        var x = c.size()
    } catch (String e) {
        threw = 1
    }
    assert(threw == 1, "must throw on missing column")
}

test "series min max" {
    var vals = listOf<Double>()
    vals.add(3.0)
    vals.add(1.0)
    vals.add(2.0)
    var s = Series("x", vals)
    assert(s.min() == 1.0, "min 1.0")
    assert(s.max() == 3.0, "max 3.0")
}
