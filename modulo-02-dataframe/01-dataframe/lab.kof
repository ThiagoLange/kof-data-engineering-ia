// modulo-02-dataframe/01-dataframe/lab.kof
//
// Minimal typed DataFrame for Kof: Series (label + List<Double>) and
// DataFrame (numeric columns + a String row index). Supported ops:
// column selection (by index/name), vectorized boolean mask filter,
// head/tail, and describe (count/mean/min/max).
//
// Source: shared/strutils.kof, shared/numberparse.kof
// Target: JVM (kof run; default target)

// ─── helpers (inline copies of shared/*.kof) ───────────────────────────

// split(s, delim): single-char delimiter; preserves empty fields.
// Source: shared/strutils.kof
split(String s, String delim): List<String> {
    var out = listOf<String>()
    if (delim.length == 0) {
        out.add(s)
        return out
    }
    var start = 0
    var n = s.length
    var i = 0
    while (i < n) {
        if (s.charAt(i) == delim.charAt(0)) {
            out.add(s.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.add(s.substring(start, n))
    return out
}

// trim ASCII whitespace. Source: shared/strutils.kof
trim(String s): String {
    var n = s.length
    var start = 0
    while (start < n) {
        var c = s.charAt(start)
        if (c != 32 && c != 9 && c != 10 && c != 13) { break }
        start = start + 1
    }
    var end = n
    while (end > start) {
        var c = s.charAt(end - 1)
        if (c != 32 && c != 9 && c != 10 && c != 13) { break }
        end = end - 1
    }
    return s.substring(start, end)
}

// Strict numeric parsing (throws on bad input). Idiomatic per
// training/idioms/errors.md — no Option<T>/Result<T in 0.1.3-beta.
// Source: shared/numberparse.kof
parseFloatStrict(String s): Double {
    if (s == null) { throw "parseFloat: null input" }
    var n = s.length
    if (n == 0) { throw "parseFloat: empty input" }
    var i = 0
    var sign = 1.0
    var c = s.charAt(0)
    if (c == 45) { sign = -1.0; i = 1 }
    else if (c == 43) { i = 1 }
    if (i >= n) { throw "parseFloat: sign only" }
    var intPart = 0.0
    var sawDigit = 0
    while (i < n) {
        var ch = s.charAt(i)
        if (ch >= 48 && ch <= 57) {
            intPart = intPart * 10.0 + ch - 48.0
            sawDigit = 1
            i = i + 1
        } else { break }
    }
    var base = sign * intPart
    var fracAcc = 0.0
    var div = 1.0
    var hasDot = 0
    if (i < n) {
        if (s.charAt(i) == 46) {
            hasDot = 1
            i = i + 1
        }
    }
    while (i < n && hasDot == 1) {
        var ch = s.charAt(i)
        if (ch >= 48 && ch <= 57) {
            fracAcc = fracAcc * 10.0 + ch - 48.0
            div = div * 10.0
            i = i + 1
        } else { break }
    }
    if (sawDigit == 0 && hasDot == 0) { throw "parseFloat: no digits" }
    if (i < n) { throw "parseFloat: trailing garbage" }
    var frac = fracAcc / div
    var value = base + frac
    return value
}

parseFloatSafe(String s, Double fallback): Double {
    try { return parseFloatStrict(s) } catch (String e) { return fallback }
}

// nearEq(a, b): |a-b| < eps — Double equality guard for assertions.
nearEq(Double a, Double b): Bool {
    var d = a - b
    if (d < 0.0) { d = -d }
    return d < 0.0001
}

// minInt/maxInt for Int domain (clamp head/tail sizes).
minInt(Int a, Int b): Int {
    if (a < b) { return a }
    return b
}

// ─── core structures ───────────────────────────────────────────────────

// SumCount: two Double accumulators returned as one record. Counting as
// Double avoids Int->Double conversions in arithmetic (see COMP002
// workarounds in docs/LIMITACOES-KOF-0.1.3.md).
record SumCount(Double sum, Double count)

// Series: a labeled numeric column. All stats that need a division are
// computed by loop-free helpers OUTSIDE the class: a Double accumulator
// reassigned inside `while` cannot be further combined after the loop in
// the same function (COMP002 frame crash, docs/LIMITACOES-KOF-0.1.3.md).
class Series(String label, List<Double> values) {
    // Constructor params generate accessors automatically (label(), values()).
    size(): Int { return values.size() }
    get(Int i): Double { return values.get(i) }

    // Raw sum: pure accumulation, returned directly.
    sum(): Double {
        var s = 0.0
        var i = 0
        var n = values.size()
        while (i < n) {
            s = s + values.get(i)
            i = i + 1
        }
        return s
    }

    // Sum and count in a single pass.
    sumCount(): SumCount {
        var s = 0.0
        var c = 0.0
        var i = 0
        var n = values.size()
        while (i < n) {
            s = s + values.get(i)
            c = c + 1.0
            i = i + 1
        }
        return SumCount(s, c)
    }

    min(): Double {
        var n = values.size()
        if (n == 0) { throw "series: min of empty column " + label }
        var m = values.get(0)
        var i = 1
        while (i < n) {
            var v = values.get(i)
            if (v < m) { m = v }
            i = i + 1
        }
        return m
    }

    max(): Double {
        var n = values.size()
        if (n == 0) { throw "series: max of empty column " + label }
        var m = values.get(0)
        var i = 1
        while (i < n) {
            var v = values.get(i)
            if (v > m) { m = v }
            i = i + 1
        }
        return m
    }

    // headRows(k): first k values (clamped to size).
    headRows(Int k): Series {
        var n = minInt(k, values.size())
        var out = listOf<Double>()
        var i = 0
        while (i < n) {
            out.add(values.get(i))
            i = i + 1
        }
        return Series(label, out)
    }

    // tailRows(k): last k values (clamped to size).
    tailRows(Int k): Series {
        var size = values.size()
        var n = minInt(k, size)
        var start = size - n
        var out = listOf<Double>()
        var i = start
        while (i < size) {
            out.add(values.get(i))
            i = i + 1
        }
        return Series(label, out)
    }

    // maskRows(mask): keep values where mask[i] == 1. Boolean vector is
    // List<Int> because Kof 0.1.3 has no List<Bool> specialization and no
    // map/filter — the mask is built by explicit loops (see maskGt).
    maskRows(List<Int> mask): Series {
        if (mask.size() != values.size()) {
            throw "series: mask size mismatch on " + label
        }
        var out = listOf<Double>()
        var i = 0
        var n = values.size()
        while (i < n) {
            if (mask.get(i) == 1) {
                out.add(values.get(i))
            }
            i = i + 1
        }
        return Series(label, out)
    }
}

// meanOf(s): loop-free — division happens outside any accumulator loop.
meanOf(Series s): Double {
    var sc = s.sumCount()
    return sc.sum / sc.count
}

// describe(s): single-line summary "label count=N mean=.. min=.. max=..".
describe(Series s): String {
    var mu = meanOf(s)
    var mn = s.min()
    var mx = s.max()
    return s.label() + " count=" + s.size().toString() +
        " mean=" + mu.toString() +
        " min=" + mn.toString() +
        " max=" + mx.toString()
}

// maskGt(s, t): vectorized comparison — the boolean-mask primitive.
// mask[i] = 1 iff s[i] > t.
maskGt(Series s, Double t): List<Int> {
    var out = listOf<Int>()
    var i = 0
    var n = s.size()
    while (i < n) {
        if (s.get(i) > t) {
            out.add(1)
        } else {
            out.add(0)
        }
        i = i + 1
    }
    return out
}

// maskSum(mask): count of 1s (kept rows).
maskSum(List<Int> mask): Int {
    var c = 0
    var i = 0
    var n = mask.size()
    while (i < n) {
        if (mask.get(i) == 1) { c = c + 1 }
        i = i + 1
    }
    return c
}

// DataFrame: numeric columns (Series) + a String row index (like the
// pandas index). iris.csv uses the species column as row labels.
class DataFrame(List<String> index, List<Series> cols) {
    nrows(): Int { return index.size() }
    ncols(): Int { return cols.size() }
    colAt(Int j): Series { return cols.get(j) }
    indexAt(Int i): String { return index.get(i) }

    // col(name): column selection by label; linear scan, throws if absent.
    col(String name): Series {
        var j = 0
        var m = cols.size()
        while (j < m) {
            if (cols.get(j).label() == name) {
                return cols.get(j)
            }
            j = j + 1
        }
        throw "dataframe: no column named " + name
    }

    // selectRows(keep): keep[i] == 1 -> row i survives, in every column
    // and in the index. Shared engine for head/tail/mask/whereIndex.
    selectRows(List<Int> keep): DataFrame {
        if (keep.size() != index.size()) {
            throw "dataframe: mask size mismatch (frame has " + index.size().toString() + " rows)"
        }
        var newIndex = listOf<String>()
        var i = 0
        var n = index.size()
        while (i < n) {
            if (keep.get(i) == 1) { newIndex.add(index.get(i)) }
            i = i + 1
        }
        var newCols = listOf<Series>()
        var j = 0
        var m = cols.size()
        while (j < m) {
            newCols.add(cols.get(j).maskRows(keep))
            j = j + 1
        }
        return DataFrame(newIndex, newCols)
    }

    // filterMask(mask): vectorized boolean row filter.
    filterMask(List<Int> mask): DataFrame {
        return selectRows(mask)
    }

    // whereIndex(value): row filter by index label equality (e.g. species).
    whereIndex(String value): DataFrame {
        var keep = listOf<Int>()
        var i = 0
        var n = index.size()
        while (i < n) {
            if (index.get(i) == value) {
                keep.add(1)
            } else {
                keep.add(0)
            }
            i = i + 1
        }
        return selectRows(keep)
    }

    // head(k): first k rows (clamped).
    head(Int k): DataFrame {
        var keep = listOf<Int>()
        var n = index.size()
        var lim = minInt(k, n)
        var i = 0
        while (i < n) {
            if (i < lim) { keep.add(1) } else { keep.add(0) }
            i = i + 1
        }
        return selectRows(keep)
    }

    // tail(k): last k rows (clamped).
    tail(Int k): DataFrame {
        var keep = listOf<Int>()
        var n = index.size()
        var lim = minInt(k, n)
        var start = n - lim
        var i = 0
        while (i < n) {
            if (i >= start) { keep.add(1) } else { keep.add(0) }
            i = i + 1
        }
        return selectRows(keep)
    }
}

// ─── loading ───────────────────────────────────────────────────────────

// loadTable(path): reads a numeric CSV whose LAST column is the row index
// (String). Builds one Series per numeric column. Strict parsing: a
// malformed numeric cell aborts with throw (data error, not sentinel).
loadTable(String path): DataFrame {
    var raw = File(path).readText()
    if (raw == null) { throw "dataframe: cannot read " + path }
    var lines = split(raw, "\n")
    if (lines.size() == 0) { throw "dataframe: empty file " + path }
    var header = split(trim(lines.get(0)), ",")
    var ncolsNum = header.size() - 1
    if (ncolsNum < 1) { throw "dataframe: need at least one numeric column" }
    var colData = listOf<List<Double>>()
    var j = 0
    while (j < ncolsNum) {
        colData.add(listOf<Double>())
        j = j + 1
    }
    var index = listOf<String>()
    var i = 1
    var n = lines.size()
    while (i < n) {
        var line = trim(lines.get(i))
        if (line.length > 0) {
            var cells = split(line, ",")
            if (cells.size() != header.size()) {
                throw "dataframe: column count mismatch at line " + i.toString()
            }
            var jj = 0
            while (jj < ncolsNum) {
                colData.get(jj).add(parseFloatStrict(trim(cells.get(jj))))
                jj = jj + 1
            }
            index.add(trim(cells.get(ncolsNum)))
        }
        i = i + 1
    }
    var cols = listOf<Series>()
    j = 0
    while (j < ncolsNum) {
        cols.add(Series(trim(header.get(j)), colData.get(j)))
        j = j + 1
    }
    return DataFrame(index, cols)
}

// ─── demo ──────────────────────────────────────────────────────────────

main() {
    var df = loadTable("datasets/iris.csv")
    println("dataframe: " + df.nrows().toString() + " rows x " + df.ncols().toString() + " cols")
    var j = 0
    while (j < df.ncols()) {
        println(describe(df.colAt(j)))
        j = j + 1
    }

    // Row filter by index label: only setosa rows.
    var setosa = df.whereIndex("setosa")
    var muSl = meanOf(setosa.col("sepal_length"))
    println("")
    println("setosa rows: " + setosa.nrows().toString() +
        " | mean sepal_length: " + muSl.toString())

    // Vectorized boolean mask: petal_length > 5.0 across the whole frame.
    var pl = df.col("petal_length")
    var mask = maskGt(pl, 5.0)
    var big = df.filterMask(mask)
    println("")
    println("petal_length > 5.0: " + big.nrows().toString() + " rows (mask sum " + maskSum(mask).toString() + ")")
    var i = 0
    while (i < big.nrows()) {
        println("  row label: " + big.indexAt(i) +
            " | petal_length=" + big.col("petal_length").get(i).toString() +
            " petal_width=" + big.col("petal_width").get(i).toString())
        i = i + 1
    }

    // head/tail on the full frame.
    var h = df.head(3)
    var t = df.tail(2)
    println("")
    println("head(3) rows: " + h.nrows().toString() + " | tail(2) rows: " + t.nrows().toString())
}
