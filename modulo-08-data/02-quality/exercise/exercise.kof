// modulo-08-data/02-quality/lab.kof
// Data Quality: expectations + kof.log + report.
// Target: JVM 0.4.9.
split(String s, String delim): List<String> { var out=listOf<String>(); var start=0; var n=s.length; var i=0; while(i<n){ if(s.charAt(i)==delim.charAt(0)){ out.add(s.substring(start,i)); start=i+1 } i=i+1 } out.add(s.substring(start,n)); return out }
trim(String s): String { var n=s.length; var start=0; while(start<n){ var c=s.charAt(start); if(c!=32&&c!=9&&c!=10&&c!=13){break} start=start+1 } var end=n; while(end>start){ var c=s.charAt(end-1); if(c!=32&&c!=9&&c!=10&&c!=13){break} end=end-1 } return s.substring(start,end) }
indexOf(String s, String needle): Int { if(needle.length==0){return 0} var n=s.length; var m=needle.length; if(m>n){return -1} var limit=n-m; var i=0; while(i<=limit){ var match=1; var j=0; while(j<m){ if(s.charAt(i+j)!=needle.charAt(j)){match=0; j=m} else{j=j+1} } if(match==1){return i} i=i+1 } return -1 }
record Customer(Int customer_id, String name, String city)
record Expectation(String name, String result)
validateCustomer(Customer c): String { if(c.name==null||trim(c.name).length==0){return "name required"} if(c.city==null||trim(c.city).length==0){return "city required"} if(c.customer_id<=0){return "id must be >0"} return "" }
validateEmail(String email): String { if(indexOf(email,"@")==-1){return "isEmail failed"} if(indexOf(email,".")==-1){return "isEmail failed"} return "" }
loadCustomers(String p): List<Customer> { var raw=File(p).readText(); if(raw==null){throw "customers: cannot read "+p} var lines=split(raw,"\n"); var out=listOf<Customer>(); var i=0; while(i<lines.size()){ var l=trim(lines.get(i)); if(l.length>0){out.add(json.decode<Customer>(l))} i=i+1 } return out }
test "validateCustomer valid" { var c=Customer(1,"Alice","SP"); var e=validateCustomer(c); assert(e=="","valid") }
test "validateCustomer empty name fails" { var c=Customer(2,"","SP"); var e=validateCustomer(c); assert(e.contains("required"),"required") }
test "validateEmail fails" { var e=validateEmail("bad"); assert(e.contains("isEmail"),"isEmail") }
test "validateEmail ok" { var e=validateEmail("a@b.com"); assert(e=="","ok") }
