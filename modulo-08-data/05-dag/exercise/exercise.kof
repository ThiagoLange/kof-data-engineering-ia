// modulo-08-data/05-dag/lab.kof
// Orquestrador DAG: ingest→validate→feature→evaluate com scheduler simulado + kof.observability.
// Target: JVM 0.3.2 compact.
split(String s, String delim): List<String> { var out=listOf<String>(); var start=0; var n=s.length; var i=0; while(i<n){ if(s.charAt(i)==delim.charAt(0)){ out.add(s.substring(start,i)); start=i+1 } i=i+1 } out.add(s.substring(start,n)); return out }
trim(String s): String { var n=s.length; var start=0; while(start<n){ var c=s.charAt(start); if(c!=32&&c!=9&&c!=10&&c!=13){break} start=start+1 } var end=n; while(end>start){ var c=s.charAt(end-1); if(c!=32&&c!=9&&c!=10&&c!=13){break} end=end-1 } return s.substring(start,end) }
record DagRun(String step, String status, Int durationMs)
class Scheduler(List<DagRun> runs) {
    runStep(String name, Int ms): String { log.info("dag: start "+name); time.sleep(ms); var ok="ok"; if(name=="validate" && ms>100){ ok="ok" } runs.add(DagRun(name, ok, ms)); log.info("dag: done "+name+" "+ok); return ok }
    health(): String { var i=0; while(i<runs.size()){ if(runs.get(i).status!="ok"){return "unhealthy"} i=i+1 } return "healthy" }
}
test "scheduler runs all steps" { var s=Scheduler(listOf<DagRun>()); s.runStep("a",5); s.runStep("b",5); assert(s.runs.size()==2,"2 runs") }
test "health ok when all ok" { var s=Scheduler(listOf<DagRun>()); s.runStep("ingest",5); assert(s.health()=="healthy","healthy") }
test "dag 4 steps" { var s=Scheduler(listOf<DagRun>()); var steps=listOf<String>(); steps.add("ingest"); steps.add("validate"); steps.add("feature"); steps.add("evaluate"); var i=0; while(i<steps.size()){ s.runStep(steps.get(i),5); i=i+1 } assert(s.runs.size()==4,"4") }
