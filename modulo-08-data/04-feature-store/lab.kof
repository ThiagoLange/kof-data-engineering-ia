// modulo-08-data/04-feature-store/lab.kof
// Feature Store: compute features (08-01 agg) + serve via in-memory Map (kof.cache-like).
// Target: JVM 0.4.7.
split(String s, String delim): List<String> { var out=listOf<String>(); var start=0; var n=s.length; var i=0; while(i<n){ if(s.charAt(i)==delim.charAt(0)){ out.add(s.substring(start,i)); start=i+1 } i=i+1 } out.add(s.substring(start,n)); return out }
trim(String s): String { var n=s.length; var start=0; while(start<n){ var c=s.charAt(start); if(c!=32&&c!=9&&c!=10&&c!=13){break} start=start+1 } var end=n; while(end>start){ var c=s.charAt(end-1); if(c!=32&&c!=9&&c!=10&&c!=13){break} end=end-1 } return s.substring(start,end) }
record Customer(Int customer_id, String name, String city)
record Transaction(Int tx_id, Int customer_id, Double amount)
record Feature(String city, Int cnt, Double tot, Double mean)
loadCustomers(String p): List<Customer> { var raw=File(p).readText(); if(raw==null){throw "customers: cannot read "+p} var lines=split(raw,"\n"); var out=listOf<Customer>(); var i=0; while(i<lines.size()){ var l=trim(lines.get(i)); if(l.length>0){out.add(json.decode<Customer>(l))} i=i+1 } return out }
loadTransactions(String p): List<Transaction> { var raw=File(p).readText(); if(raw==null){throw "tx: cannot read "+p} var lines=split(raw,"\n"); var out=listOf<Transaction>(); var i=0; while(i<lines.size()){ var l=trim(lines.get(i)); if(l.length>0){out.add(json.decode<Transaction>(l))} i=i+1 } return out }
// compute features (same as 08-01)
computeFeatures(List<Transaction> txs, List<Customer> cs): List<Feature> { var names=listOf<String>(); var counts=listOf<Int>(); var sums=listOf<Double>(); var i=0; while(i<txs.size()){ var t=txs.get(i); var city=""; var j=0; while(j<cs.size()){ if(cs.get(j).customer_id==t.customer_id){city=cs.get(j).city; j=cs.size()} else{j=j+1} } var idx=-1; var k=0; while(k<names.size()){ if(names.get(k)==city){idx=k; k=names.size()} else{k=k+1} } if(idx==-1){ names.add(city); counts.add(1); sums.add(t.amount) } else{ counts.set(idx, counts.get(idx)+1); sums.set(idx, sums.get(idx)+t.amount) } i=i+1 } var out=listOf<Feature>(); var b=0; while(b<names.size()){ var c=counts.get(b); var tot=sums.get(b); var mu=tot/(1.0*c); out.add(Feature(names.get(b),c,tot,mu)); b=b+1 } return out }
// Simple cache: parallel lists city->Feature (kof.cache-like, TTL not needed for demo)
class FeatureStore(List<String> keys, List<Feature> vals) {
    put(Feature f): Int { var i=0; while(i<keys.size()){ if(keys.get(i)==f.city){ vals.set(i,f); return 0 } i=i+1 } keys.add(f.city); vals.add(f); return 0 }
    get(String city): Feature { var i=0; while(i<keys.size()){ if(keys.get(i)==city){return vals.get(i)} i=i+1 } throw "feature store: not found city "+city }
    size(): Int { return keys.size() }
}
main() {
    var cs=loadCustomers("datasets/customers.jsonl")
    var txs=loadTransactions("datasets/transactions.jsonl")
    var feats=computeFeatures(txs,cs)
    println("features computed: "+feats.size().toString())
    var store=FeatureStore(listOf<String>(), listOf<Feature>())
    var i=0; while(i<feats.size()){ store.put(feats.get(i)); println("  store put "+feats.get(i).city+" cnt="+feats.get(i).cnt.toString()+" mean="+feats.get(i).mean.toString()); i=i+1 }
    // online serving
    var q="SP"; var f=store.get(q); println("online get "+q+": cnt="+f.cnt.toString()+" tot="+f.tot.toString())
    // offline batch: materialize to file (simulate kof.db)
    var sb=""; var k=0; while(k<feats.size()){ if(k>0){sb=sb+"\n"} sb=sb+json.encode(feats.get(k)); k=k+1 } var path="modulo-08-data/04-feature-store/features.jsonl"; File(path).writeText(sb); println("materialized to "+path+" ("+sb.length.toString()+" bytes)")
    // reload
    var raw=File(path).readText(); var lines=split(raw,"\n"); println("reloaded lines: "+lines.size().toString())
    File(path).delete(); println("cleaned")
}
