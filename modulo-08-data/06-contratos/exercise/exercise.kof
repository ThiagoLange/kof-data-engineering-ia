// modulo-08-data/06-contratos/lab.kof
// Contratos & Linhagem: schema version + correlationId por tx + lineage.jsonl.
// Target: JVM 0.4.10.
split(String s, String delim): List<String> { var out=listOf<String>(); var start=0; var n=s.length; var i=0; while(i<n){ if(s.charAt(i)==delim.charAt(0)){ out.add(s.substring(start,i)); start=i+1 } i=i+1 } out.add(s.substring(start,n)); return out }
trim(String s): String { var n=s.length; var start=0; while(start<n){ var c=s.charAt(start); if(c!=32&&c!=9&&c!=10&&c!=13){break} start=start+1 } var end=n; while(end>start){ var c=s.charAt(end-1); if(c!=32&&c!=9&&c!=10&&c!=13){break} end=end-1 } return s.substring(start,end) }
record Schema(Int version, String columns)
record Lineage(String txId, String source, String transform, String sink, String correlationId)
validateSchema(Schema s, String rawHeader): String { if(s.version!=1){return "schema version mismatch"} if(rawHeader!=s.columns){return "columns mismatch: expected "+s.columns} return "" }
test "schema ok" { var s=Schema(1,"a,b"); var e=validateSchema(s,"a,b"); assert(e=="","ok") }
test "schema version mismatch" { var s=Schema(2,"a,b"); var e=validateSchema(s,"a,b"); assert(e.contains("version"),"version") }
test "lineage correlationId" { var l=Lineage("101","src","tr","sink","corr-101"); assert(l.correlationId=="corr-101","corr") }
