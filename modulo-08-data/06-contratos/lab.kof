// modulo-08-data/06-contratos/lab.kof
// Contratos & Linhagem: schema version + correlationId por tx + lineage.jsonl.
// Target: JVM 0.4.10.
split(String s, String delim): List<String> { var out=listOf<String>(); var start=0; var n=s.length; var i=0; while(i<n){ if(s.charAt(i)==delim.charAt(0)){ out.add(s.substring(start,i)); start=i+1 } i=i+1 } out.add(s.substring(start,n)); return out }
trim(String s): String { var n=s.length; var start=0; while(start<n){ var c=s.charAt(start); if(c!=32&&c!=9&&c!=10&&c!=13){break} start=start+1 } var end=n; while(end>start){ var c=s.charAt(end-1); if(c!=32&&c!=9&&c!=10&&c!=13){break} end=end-1 } return s.substring(start,end) }
record Schema(Int version, String columns)
record Lineage(String txId, String source, String transform, String sink, String correlationId)
validateSchema(Schema s, String rawHeader): String { if(s.version!=1){return "schema version mismatch"} if(rawHeader!=s.columns){return "columns mismatch: expected "+s.columns} return "" }
main() {
    var schema=Schema(1,"tx_id,customer_id,amount")
    var header="tx_id,customer_id,amount"
    var err=validateSchema(schema, header)
    if(err!=""){ log.error("schema fail: "+err) } else{ log.info("schema ok v"+schema.version.toString()) }
    println("schema check: "+err)
    // lineage per transaction
    var lineage=listOf<Lineage>()
    var txIds=listOf<String>(); txIds.add("101"); txIds.add("102"); txIds.add("103")
    var i=0; while(i<txIds.size()){
        var cid="corr-"+txIds.get(i)
        var l=Lineage(txIds.get(i), "transactions.jsonl", "join+agg", "lake_SP_v1.jsonl", cid)
        log.info("lineage "+l.txId+" corr="+cid)
        lineage.add(l)
        i=i+1
    }
    var path="modulo-08-data/06-contratos/lineage.jsonl"
    var sb=""; var k=0; while(k<lineage.size()){ if(k>0){sb=sb+"\n"} sb=sb+json.encode(lineage.get(k)); k=k+1 }
    File(path).writeText(sb); println("wrote "+path+" ("+lineage.size().toString()+" entries)")
    // read back
    var raw=File(path).readText(); var lines=split(raw,"\n"); println("lineage lines: "+lines.size().toString())
    File(path).delete(); println("cleaned")
}
