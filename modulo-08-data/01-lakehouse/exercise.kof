// modulo-08-data/01-lakehouse/lab.kof
// Lakehouse incremental: partição por city + watermark append-only + time travel.
// Target: JVM 0.3.2 compact.
split(String s, String delim): List<String> { var out=listOf<String>(); var start=0; var n=s.length; var i=0; while(i<n){ if(s.charAt(i)==delim.charAt(0)){ out.add(s.substring(start,i)); start=i+1 } i=i+1 } out.add(s.substring(start,n)); return out }
trim(String s): String { var n=s.length; var start=0; while(start<n){ var c=s.charAt(start); if(c!=32&&c!=9&&c!=10&&c!=13){break} start=start+1 } var end=n; while(end>start){ var c=s.charAt(end-1); if(c!=32&&c!=9&&c!=10&&c!=13){break} end=end-1 } return s.substring(start,end) }
indexOf(String s, String needle): Int { if(needle.length==0){return 0} var n=s.length; var m=needle.length; if(m>n){return -1} var limit=n-m; var i=0; while(i<=limit){ var match=1; var j=0; while(j<m){ if(s.charAt(i+j)!=needle.charAt(j)){match=0; j=m} else{j=j+1} } if(match==1){return i} i=i+1 } return -1 }
record Customer(Int customer_id, String name, String city)
record Transaction(Int tx_id, Int customer_id, Double amount)
record Watermark(Int lastTxId, Int version)
loadCustomers(String p): List<Customer> { var raw=File(p).readText(); if(raw==null){throw "customers: cannot read "+p} var lines=split(raw,"\n"); var out=listOf<Customer>(); var i=0; while(i<lines.size()){ var l=trim(lines.get(i)); if(l.length>0){ out.add(json.decode<Customer>(l)) } i=i+1 } return out }
loadTransactions(String p): List<Transaction> { var raw=File(p).readText(); if(raw==null){throw "tx: cannot read "+p} var lines=split(raw,"\n"); var out=listOf<Transaction>(); var i=0; while(i<lines.size()){ var l=trim(lines.get(i)); if(l.length>0){ out.add(json.decode<Transaction>(l)) } i=i+1 } return out }
cityForTx(Transaction t, List<Customer> cs): String { var i=0; while(i<cs.size()){ if(cs.get(i).customer_id==t.customer_id){return cs.get(i).city} i=i+1 } return "unknown" }
writePartition(String city, List<Transaction> txs, List<Customer> cs, Int version): Int { var filtered=listOf<Transaction>(); var i=0; while(i<txs.size()){ if(cityForTx(txs.get(i),cs)==city){ filtered.add(txs.get(i)) } i=i+1 } if(filtered.size()==0){return 0} var sb=""; var k=0; while(k<filtered.size()){ if(k>0){sb=sb+"\n"} sb=sb+json.encode(filtered.get(k)); k=k+1 } var path="modulo-08-data/01-lakehouse/lake_"+city+"_v"+version.toString()+".jsonl"; File(path).writeText(sb); return filtered.size() }
readWatermark(String path): Watermark { var raw=File(path).readText(); if(raw==null){ return Watermark(0,0) } var lines=split(raw,"\n"); var lastLine=""; var i=0; while(i<lines.size()){ var l=trim(lines.get(i)); if(l.length>0){lastLine=l} i=i+1 } if(lastLine.length==0){return Watermark(0,0)} var parts=split(lastLine, ","); if(parts.size()<2){return Watermark(0,0)} var idStr=trim(parts.get(0)); var verStr=trim(parts.get(1)); var id=0; var v=0; var k=0; while(k<idStr.length){ var ch=idStr.charAt(k); id=id*10+(ch-48); k=k+1 } k=0; while(k<verStr.length){ var ch2=verStr.charAt(k); v=v*10+(ch2-48); k=k+1 } return Watermark(id,v) }
writeWatermark(String path, Watermark w): Int { var prev=File(path).readText(); var sb=""; if(prev!=null && prev.length>0){ sb=prev+"\n" } sb=sb+w.lastTxId.toString()+","+w.version.toString(); File(path).writeText(sb); return 0 }
incrementalIngest(List<Transaction> allTxs, List<Customer> cs, String watermarkPath): Watermark { var wm=readWatermark(watermarkPath); var newTxs=listOf<Transaction>(); var i=0; while(i<allTxs.size()){ if(allTxs.get(i).tx_id > wm.lastTxId){ newTxs.add(allTxs.get(i)) } i=i+1 } if(newTxs.size()==0){ return wm } var cities=listOf<String>(); var j=0; while(j<newTxs.size()){ var c=cityForTx(newTxs.get(j),cs); var found=0; var k=0; while(k<cities.size()){ if(cities.get(k)==c){found=1} k=k+1 } if(found==0){cities.add(c)} j=j+1 } var nextVer=wm.version+1; var p=0; while(p<cities.size()){ writePartition(cities.get(p), newTxs, cs, nextVer); p=p+1 } var maxId=wm.lastTxId; var q=0; while(q<newTxs.size()){ if(newTxs.get(q).tx_id>maxId){maxId=newTxs.get(q).tx_id} q=q+1 } var newWm=Watermark(maxId, nextVer); writeWatermark(watermarkPath, newWm); return newWm }
main() {
    var cs=loadCustomers("datasets/customers.jsonl")
    var all=loadTransactions("datasets/transactions.jsonl")
    var wmPath="modulo-08-data/01-lakehouse/watermark.csv"
    // initial ingest
    var w1=incrementalIngest(all, cs, wmPath)
    println("ingest v"+w1.version.toString()+" lastTx="+w1.lastTxId.toString())
    // second ingest with no new data (idempotency)
    var w2=incrementalIngest(all, cs, wmPath)
    println("second ingest v"+w2.version.toString()+" (should be same)")
    // simulate new transaction
    var extra=listOf<Transaction>(); extra.add(Transaction(108, 1, 500.0))
    var combined=listOf<Transaction>(); var i=0; while(i<all.size()){ combined.add(all.get(i)); i=i+1 } combined.add(extra.get(0))
    var w3=incrementalIngest(combined, cs, wmPath)
    println("third ingest v"+w3.version.toString()+" lastTx="+w3.lastTxId.toString()+" (incremental)")
    // time travel: read watermark history
    var hist=File(wmPath).readText()
    println("watermark history:\n"+hist)
    var spFile="modulo-08-data/01-lakehouse/lake_SP_v1.jsonl"
    var spRaw=File(spFile).readText()
    if(spRaw!=null){ var spLines=split(spRaw,"\n"); println("SP partition v1 rows: "+spLines.size().toString()) }
}
test "incremental ingest idempotent" { var cs=loadCustomers("datasets/customers.jsonl"); var all=loadTransactions("datasets/transactions.jsonl"); var p="modulo-08-data/01-lakehouse/test_watermark.csv"; File(p).writeText(""); var w1=incrementalIngest(all,cs,p); var w2=incrementalIngest(all,cs,p); assert(w1.version==w2.version,"idempotent"); File(p).delete() }
test "cityForTx SP" { var cs=loadCustomers("datasets/customers.jsonl"); var t=Transaction(101,1,10.0); var c=cityForTx(t,cs); assert(c=="SP","SP") }
test "watermark persists" { var p="modulo-08-data/01-lakehouse/test_wm2.csv"; File(p).writeText(""); var cs=loadCustomers("datasets/customers.jsonl"); var all=loadTransactions("datasets/transactions.jsonl"); var w=incrementalIngest(all,cs,p); var r=readWatermark(p); assert(r.lastTxId==107,"107"); File(p).delete(); File("modulo-08-data/01-lakehouse/lake_SP_v1.jsonl").delete(); File("modulo-08-data/01-lakehouse/lake_RJ_v1.jsonl").delete(); File("modulo-08-data/01-lakehouse/lake_MG_v1.jsonl").delete() }
