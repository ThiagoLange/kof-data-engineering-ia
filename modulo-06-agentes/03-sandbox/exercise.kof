// modulo-06-agentes/03-sandbox/lab.kof
// Tool sandbox — compact format due to 0.3.2 LineNumberTable bug (see docs/LIMITACOES).
// Source: shared/strutils.kof
// Target: JVM (File, time.sleep)
split(String s, String delim): List<String> { var out=listOf<String>(); var start=0; var n=s.length; var i=0; while(i<n){ if(s.charAt(i)==delim.charAt(0)){ out.add(s.substring(start,i)); start=i+1 } i=i+1 } out.add(s.substring(start,n)); return out }
trim(String s): String { var n=s.length; var start=0; while(start<n){ var c=s.charAt(start); if(c!=32&&c!=9&&c!=10&&c!=13){break} start=start+1 } var end=n; while(end>start){ var c=s.charAt(end-1); if(c!=32&&c!=9&&c!=10&&c!=13){break} end=end-1 } return s.substring(start,end) }
indexOf(String s, String needle): Int { if(needle.length==0){return 0} var n=s.length; var m=needle.length; if(m>n){return -1} var limit=n-m; var i=0; while(i<=limit){ var match=1; var j=0; while(j<m){ if(s.charAt(i+j)!=needle.charAt(j)){match=0; j=m} else{j=j+1} } if(match==1){return i} i=i+1 } return -1 }
jsonFieldString(String body, String key): String { var keyPat="\""+key+"\""; var idx=indexOf(body,keyPat); if(idx==-1){throw "sandbox: key not found: "+key} var pos=idx+keyPat.length; while(pos<body.length){ var ch=body.charAt(pos); if(ch==32||ch==9||ch==10||ch==13){pos=pos+1} else if(ch==58){pos=pos+1} else{break} } while(pos<body.length){ var ch2=body.charAt(pos); if(ch2==32||ch2==9||ch2==10||ch2==13){pos=pos+1} else{break} } if(pos>=body.length||body.charAt(pos)!=34){throw "sandbox: expected quoted string for "+key} pos=pos+1; var sb=""; var k=pos; while(k<body.length){ var c=body.charAt(k); if(c==92){ k=k+1; if(k<body.length){ var e=body.charAt(k); if(e==110){sb=sb+"\n"} else if(e==116){sb=sb+"\t"} else{sb=sb+body.substring(k,k+1)} } } else if(c==34){return sb} else{sb=sb+body.substring(k,k+1)} k=k+1 } throw "sandbox: unterminated string for "+key }
extractJsonNumber(String body, String key): String { var keyPat="\""+key+"\""; var idx=indexOf(body,keyPat); if(idx==-1){throw "sandbox: key not found: "+key} var pos=idx+keyPat.length; while(pos<body.length){ var ch=body.charAt(pos); if(ch==32||ch==9||ch==10||ch==13){pos=pos+1} else if(ch==58){pos=pos+1} else{break} } while(pos<body.length){ var ch2=body.charAt(pos); if(ch2==32||ch2==9||ch2==10||ch2==13){pos=pos+1} else{break} } var start=pos; var end=start; while(end<body.length){ var cc=body.charAt(end); if((cc>=48&&cc<=57)||cc==46||cc==45||cc==43){end=end+1} else{break} } if(start==end){throw "sandbox: expected number for "+key} return trim(body.substring(start,end)) }
parseFloatStrict(String s): Double { if(s==null){throw "parseFloat: null input"} var n=s.length; if(n==0){throw "parseFloat: empty input"} var i=0; var sign=1.0; var c=s.charAt(0); if(c==45){sign=-1.0; i=1} else if(c==43){i=1} if(i>=n){throw "parseFloat: sign only"} var intPart=0.0; var saw=0; while(i<n){ var ch=s.charAt(i); if(ch>=48&&ch<=57){intPart=intPart*10.0+ch-48.0; saw=1; i=i+1} else{break} } var base=sign*intPart; var fracAcc=0.0; var div=1.0; var hasDot=0; if(i<n && s.charAt(i)==46){hasDot=1; i=i+1} while(i<n && hasDot==1){ var ch=s.charAt(i); if(ch>=48&&ch<=57){fracAcc=fracAcc*10.0+ch-48.0; div=div*10.0; i=i+1} else{break} } if(saw==0&&hasDot==0){throw "parseFloat: no digits"} if(i<n){throw "parseFloat: trailing garbage"} var frac=fracAcc/div; if(sign<0.0){frac=-frac} return base+frac }
record Call(String tool, String argsJson)
record Result(Int ok, String output, String error)
calculator(String argsJson): String { var rawA=extractJsonNumber(argsJson,"a"); var rawB=extractJsonNumber(argsJson,"b"); var op=jsonFieldString(argsJson,"op"); var a=parseFloatStrict(rawA); var b=parseFloatStrict(rawB); var res=0.0; if(op=="+"){res=a+b} else if(op=="-"){res=a-b} else if(op=="*"){res=a*b} else if(op=="/"){ if(b==0.0){throw "calculator: division by zero"} res=a/b } else{throw "calculator: unknown op "+op} return res.toString() }
getCustomer(String argsJson): String { var city=jsonFieldString(argsJson,"city"); if(city.length==0){throw "get_customer: city required"} var raw=File("datasets/customers.jsonl").readText(); if(raw==null){throw "get_customer: cannot read customers.jsonl"} var lines=split(raw,"\n"); var sb="["; var first=1; var i=0; while(i<lines.size()){ var line=trim(lines.get(i)); if(line.length>0 && indexOf(line,"\"city\":\""+city+"\"")!=-1){ if(first==0){sb=sb+","} sb=sb+line; first=0 } i=i+1 } sb=sb+"]"; if(first==1){return "[] no customers in city "+city} return sb }
fetchDoc(String argsJson): String { var id=jsonFieldString(argsJson,"id"); if(id.length==0){throw "fetch_doc: id required"} var raw=File("datasets/docs.jsonl").readText(); if(raw==null){throw "fetch_doc: cannot read docs.jsonl"} var lines=split(raw,"\n"); var i=0; while(i<lines.size()){ var line=trim(lines.get(i)); if(line.length>0 && indexOf(line,"\"id\":\""+id+"\"")!=-1){ return jsonFieldString(line,"body") } i=i+1 } throw "fetch_doc: not found id="+id }
slowTool(String argsJson): String { time.sleep(200); return "slow result" }
dispatch(Call call, Int timeoutMs): Result { var name=call.tool; var args=call.argsJson; if(name!="calculator" && name!="get_customer" && name!="fetch_doc" && name!="slow_tool"){ return Result(0,"","unknown tool: "+name) } if(name=="slow_tool" && timeoutMs<200){ return Result(0,"","timeout after "+timeoutMs.toString()+"ms on tool slow_tool") } try{ var out=""; if(name=="calculator"){out=calculator(args)} else if(name=="get_customer"){out=getCustomer(args)} else if(name=="fetch_doc"){out=fetchDoc(args)} else if(name=="slow_tool"){out=slowTool(args)} return Result(1,out,"") } catch(String e){ return Result(0,"",e) } }
main() { var calls=listOf<Call>(); calls.add(Call("calculator","{\"a\": 12.0, \"b\": 3.0, \"op\": \"*\"}")); calls.add(Call("calculator","{\"a\": 10.0, \"b\": 0.0, \"op\": \"/\"}")); calls.add(Call("get_customer","{\"city\": \"SP\"}")); calls.add(Call("get_customer","{\"city\": \"\"}")); calls.add(Call("fetch_doc","{\"id\": \"d1\"}")); calls.add(Call("fetch_doc","{\"id\": \"missing\"}")); calls.add(Call("unknown_tool","{}")); calls.add(Call("slow_tool","{}")); println("sandbox dispatcher demo (timeout=500ms except slow_tool test 50ms):"); var i=0; while(i<calls.size()){ var c=calls.get(i); var timeout=500; if(c.tool=="slow_tool"){timeout=50} var r=dispatch(c,timeout); var status="ERR"; if(r.ok==1){status="OK"} println("  "+c.tool+" -> "+status+" output=\""+r.output+"\" error=\""+r.error+"\""); i=i+1 } }
test "calculator add" { var r=dispatch(Call("calculator","{\"a\": 10.0, \"b\": 5.0, \"op\": \"+\"}"),500); assert(r.ok==1,"ok") }
test "get_customer SP" { var r=dispatch(Call("get_customer","{\"city\": \"SP\"}"),500); assert(r.ok==1,"ok"); assert(r.output.contains("Alice"),"Alice") }
test "fetch_doc d1" { var r=dispatch(Call("fetch_doc","{\"id\": \"d1\"}"),500); assert(r.ok==1,"ok") }
test "slow timeout" { var r=dispatch(Call("slow_tool","{}"),50); assert(r.ok==0,"timeout") }
test "unknown fails" { var r=dispatch(Call("unknown_tool","{}"),500); assert(r.ok==0,"unknown") }
test "calculator div by zero" { var r=dispatch(Call("calculator","{\"a\": 10.0, \"b\": 0.0, \"op\": \"/\"}"),500); assert(r.ok==0,"div0") }
test "fetch missing fails" { var r=dispatch(Call("fetch_doc","{\"id\": \"missing\"}"),500); assert(r.ok==0,"missing") }
test "get empty city fails" { var r=dispatch(Call("get_customer","{\"city\": \"\"}"),500); assert(r.ok==0,"empty") }
test "slow success" { var r=dispatch(Call("slow_tool","{}"),500); assert(r.ok==1,"slow ok") }
test "calculator unknown op" { var r=dispatch(Call("calculator","{\"a\": 1.0, \"b\": 1.0, \"op\": \"%\"}"),500); assert(r.ok==0,"op") }
