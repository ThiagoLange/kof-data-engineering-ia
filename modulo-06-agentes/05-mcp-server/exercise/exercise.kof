// modulo-06-agentes/05-mcp-server/lab.kof
// MCP-like Tool Server: expõe tools via kof.web (simulado com log + File).
// Target: JVM 0.4.7.
split(String s, String delim): List<String> { var out=listOf<String>(); var start=0; var n=s.length; var i=0; while(i<n){ if(s.charAt(i)==delim.charAt(0)){ out.add(s.substring(start,i)); start=i+1 } i=i+1 } out.add(s.substring(start,n)); return out }
trim(String s): String { var n=s.length; var start=0; while(start<n){ var c=s.charAt(start); if(c!=32&&c!=9&&c!=10&&c!=13){break} start=start+1 } var end=n; while(end>start){ var c=s.charAt(end-1); if(c!=32&&c!=9&&c!=10&&c!=13){break} end=end-1 } return s.substring(start,end) }
indexOf(String s, String needle): Int { if(needle.length==0){return 0} var n=s.length; var m=needle.length; if(m>n){return -1} var limit=n-m; var i=0; while(i<=limit){ var match=1; var j=0; while(j<m){ if(s.charAt(i+j)!=needle.charAt(j)){match=0; j=m} else{j=j+1} } if(match==1){return i} i=i+1 } return -1 }
record ToolDef(String name, String description)
// Simulated kof.web: log + File as endpoint registry
class ToolServer(List<ToolDef> tools) {
    register(String name, String desc): Int { tools.add(ToolDef(name,desc)); log.info("tool registered: "+name); return tools.size() }
    list(): String { var sb="["; var i=0; while(i<tools.size()){ if(i>0){sb=sb+","} sb=sb+"{\"name\":\""+tools.get(i).name+"\",\"desc\":\""+tools.get(i).description+"\"}" ; i=i+1 } sb=sb+"]"; return sb }
    call(String name, String argsJson): String { var i=0; while(i<tools.size()){ if(tools.get(i).name==name){ log.info("tool call "+name+" args="+argsJson); if(name=="calculator"){ return "{\"result\": 42}" } return "{\"ok\": true}" } i=i+1 } throw "unknown tool "+name }
}
test "tool server register and list" { var s=ToolServer(listOf<ToolDef>()); s.register("a","desc a"); assert(s.tools.size()==1,"1") }
test "tool server call known" { var s=ToolServer(listOf<ToolDef>()); s.register("calculator","calc"); var r=s.call("calculator","{}"); assert(r.contains("result")||r.contains("ok"),"ok") }
test "tool server unknown throws" { var s=ToolServer(listOf<ToolDef>()); var threw=0; try{ var r=s.call("unknown","{}") } catch(String e){ threw=1 } assert(threw==1,"throw") }
