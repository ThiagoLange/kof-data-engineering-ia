// modulo-09-portabilidade/02-perf/lab.kof
// Perf: kof profile + native vs JVM comparison (simulado, log + time).
// Target: JVM 0.4.9.
main() {
    log.info("perf: kof profile modulo-04-deep/01-tensor/lab.kof")
    println("JVM profile: RSS ~120MB, CPU ~0.8s for 15x4 matmul")
    // Simulate native build gate check
    log.info("native: kof build --target native -> check CONC001/DB001 gates")
    println("try: kof build --target native modulo-04-deep/01-tensor/lab.kof")
    println("try: kof build --target js modulo-04-deep/01-tensor/lab.kof")
    // Simulate timing
    var start=0; var i=0; while(i<1000000){ start=start+1; i=i+1 }
    log.info("perf: loop 1M done")
    println("perf done: loop "+start.toString())
}
