// modulo-03-ml/04-metricas/exercise.kof
// Run with: kof test modulo-03-ml/04-metricas/exercise.kof

split(String s, String delim): List<String> {
    var out = listOf<String>()
    if (delim.length == 0) { out.add(s); return out }
    var start = 0
    var n = s.length
    var i = 0
    while (i < n) { if (s.charAt(i) == delim.charAt(0)) { out.add(s.substring(start, i)); start = i + 1 } i = i + 1 }
    out.add(s.substring(start, n))
    return out
}

trim(String s): String {
    var n = s.length
    var start = 0
    while (start < n) { var c = s.charAt(start); if (c != 32 && c != 9 && c != 10 && c != 13) { break } start = start + 1 }
    var end = n
    while (end > start) { var c = s.charAt(end - 1); if (c != 32 && c != 9 && c != 10 && c != 13) { break } end = end - 1 }
    return s.substring(start, end)
}

scanIntArray(String line): List<Int> {
    var start = -1
    var end = -1
    var i = 0
    while (i < line.length) { if (line.charAt(i) == 91) { start = i; i = line.length } else { i = i + 1 } }
    if (start == -1) { throw "metrics: no [ found" }
    i = start + 1
    while (i < line.length) { if (line.charAt(i) == 93) { end = i; i = line.length } else { i = i + 1 } }
    if (end == -1) { throw "metrics: no ] found" }
    var inside = line.substring(start + 1, end)
    var parts = split(inside, ",")
    var out = listOf<Int>()
    var j = 0
    while (j < parts.size()) {
        var tok = trim(parts.get(j))
        if (tok.length > 0) {
            var sign = 1
            var k = 0
            if (tok.charAt(0) == 45) { sign = -1; k = 1 }
            var acc = 0
            while (k < tok.length) { var ch = tok.charAt(k); acc = acc * 10 + (ch - 48); k = k + 1 }
            out.add(sign * acc)
        }
        j = j + 1
    }
    return out
}

record Confusion(Int tp, Int tn, Int fp, Int falseNeg)
record Metrics(Double accuracy, Double precision, Double recall, Double f1)

confusionMatrix(List<Int> yTrue, List<Int> yPred): Confusion {
    if (yTrue.size() != yPred.size()) { throw "metrics: size mismatch" }
    if (yTrue.size() == 0) { throw "metrics: empty" }
    var tp = 0
    var tn = 0
    var fp = 0
    var falseNeg = 0
    var i = 0
    while (i < yTrue.size()) {
        var t = yTrue.get(i)
        var p = yPred.get(i)
        if (t == 1 && p == 1) { tp = tp + 1 }
        else if (t == 0 && p == 0) { tn = tn + 1 }
        else if (t == 0 && p == 1) { fp = fp + 1 }
        else if (t == 1 && p == 0) { falseNeg = falseNeg + 1 }
        else { throw "metrics: labels must be 0/1" }
        i = i + 1
    }
    return Confusion(tp, tn, fp, falseNeg)
}

accuracy(Confusion c): Double {
    var total = c.tp + c.tn + c.fp + c.falseNeg
    var correct = c.tp + c.tn
    return (1.0 * correct) / (1.0 * total)
}

precision(Confusion c): Double {
    var denom = c.tp + c.fp
    if (denom == 0) { return 0.0 }
    return (1.0 * c.tp) / (1.0 * denom)
}

recall(Confusion c): Double {
    var denom = c.tp + c.falseNeg
    if (denom == 0) { return 0.0 }
    return (1.0 * c.tp) / (1.0 * denom)
}

f1Score(Double prec, Double rec): Double {
    var denom = prec + rec
    if (denom == 0.0) { return 0.0 }
    return 2.0 * prec * rec / denom
}

computeMetrics(List<Int> yTrue, List<Int> yPred): Metrics {
    var cm = confusionMatrix(yTrue, yPred)
    var acc = accuracy(cm)
    var prec = precision(cm)
    var rec = recall(cm)
    var f1 = f1Score(prec, rec)
    return Metrics(acc, prec, rec, f1)
}

loadEval(String path): List<List<Int>> {
    var raw = File(path).readText()
    if (raw == null) { throw "metrics: cannot read " + path }
    var lines = split(raw, "\n")
    var dataLine = ""
    var i = 0
    while (i < lines.size()) { var l = trim(lines.get(i)); if (l.length > 0) { dataLine = l; i = lines.size() } else { i = i + 1 } }
    if (dataLine.length == 0) { throw "metrics: empty eval file" }
    var marker = "\"y_pred\":"
    var idx = -1
    var k = 0
    while (k <= dataLine.length - marker.length) {
        var ok = 1
        var j = 0
        while (j < marker.length) { if (dataLine.charAt(k + j) != marker.charAt(j)) { ok = 0; j = marker.length } else { j = j + 1 } }
        if (ok == 1) { idx = k; k = dataLine.length } else { k = k + 1 }
    }
    if (idx == -1) { throw "metrics: y_pred not found" }
    var left = dataLine.substring(0, idx)
    var right = dataLine.substring(idx, dataLine.length)
    var yt = scanIntArray(left)
    var yp = scanIntArray(right)
    var out = listOf<List<Int>>()
    out.add(yt)
    out.add(yp)
    return out
}

// ─── tests ─────────────────────────────────────────────────────────────

test "dataset confusion TP5 TN3 FP1 FN1" {
    var packed = loadEval("datasets/classification_eval.jsonl")
    var yt = packed.get(0)
    var yp = packed.get(1)
    var cm = confusionMatrix(yt, yp)
    assert(cm.tp == 5, "TP 5 got " + cm.tp.toString())
    assert(cm.tn == 3, "TN 3 got " + cm.tn.toString())
    assert(cm.fp == 1, "FP 1 got " + cm.fp.toString())
    assert(cm.falseNeg == 1, "FN 1 got " + cm.falseNeg.toString())
}

test "dataset accuracy 0.8" {
    var packed = loadEval("datasets/classification_eval.jsonl")
    var m = computeMetrics(packed.get(0), packed.get(1))
    var d = m.accuracy - 0.8
    if (d < 0.0) { d = -d }
    assert(d < 0.0001, "accuracy 0.8 got " + m.accuracy.toString())
}

test "dataset precision and recall 0.833" {
    var packed = loadEval("datasets/classification_eval.jsonl")
    var m = computeMetrics(packed.get(0), packed.get(1))
    var dp = m.precision - 0.833333
    if (dp < 0.0) { dp = -dp }
    assert(dp < 0.001, "precision ~0.833 got " + m.precision.toString())
    var dr = m.recall - 0.833333
    if (dr < 0.0) { dr = -dr }
    assert(dr < 0.001, "recall ~0.833 got " + m.recall.toString())
}

test "f1 0.833" {
    var packed = loadEval("datasets/classification_eval.jsonl")
    var m = computeMetrics(packed.get(0), packed.get(1))
    var d = m.f1 - 0.833333
    if (d < 0.0) { d = -d }
    assert(d < 0.001, "f1 ~0.833 got " + m.f1.toString())
}

test "perfect predictions f1=1" {
    var yt = listOf<Int>()
    yt.add(1); yt.add(0); yt.add(1); yt.add(0)
    var yp = listOf<Int>()
    yp.add(1); yp.add(0); yp.add(1); yp.add(0)
    var m = computeMetrics(yt, yp)
    var d = m.f1 - 1.0
    if (d < 0.0) { d = -d }
    assert(d < 0.0001, "perfect f1 1.0 got " + m.f1.toString())
    assert(m.accuracy == 1.0, "accuracy 1.0")
}

test "all negative predictions precision 0" {
    var yt = listOf<Int>()
    yt.add(1); yt.add(1); yt.add(0)
    var yp = listOf<Int>()
    yp.add(0); yp.add(0); yp.add(0)
    var cm = confusionMatrix(yt, yp)
    assert(precision(cm) == 0.0, "precision 0 when no TP")
    assert(recall(cm) == 0.0, "recall 0 when no TP")
    var f = f1Score(precision(cm), recall(cm))
    assert(f == 0.0, "f1 0 when prec=rec=0")
}

test "size mismatch throws" {
    var a = listOf<Int>()
    a.add(1); a.add(0)
    var b = listOf<Int>()
    b.add(1)
    var threw = 0
    try { var c = confusionMatrix(a, b) } catch (String e) { threw = 1 }
    assert(threw == 1, "must throw on size mismatch")
}
