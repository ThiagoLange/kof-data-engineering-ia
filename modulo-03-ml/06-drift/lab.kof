// modulo-03-ml/06-drift/lab.kof
// PSI / drift e calibration (ECE) para MLP/iris.
// Target: JVM 0.4.10.
split(String s, String delim): List<String> { var out=listOf<String>(); var start=0; var n=s.length; var i=0; while(i<n){ if(s.charAt(i)==delim.charAt(0)){ out.add(s.substring(start,i)); start=i+1 } i=i+1 } out.add(s.substring(start,n)); return out }
trim(String s): String { var n=s.length; var start=0; while(start<n){ var c=s.charAt(start); if(c!=32&&c!=9&&c!=10&&c!=13){break} start=start+1 } var end=n; while(end>start){ var c=s.charAt(end-1); if(c!=32&&c!=9&&c!=10&&c!=13){break} end=end-1 } return s.substring(start,end) }
parseFloatStrict(String s): Double { if(s==null){throw "parseFloat: null"} var n=s.length; if(n==0){throw "parseFloat: empty"} var i=0; var sign=1.0; var c=s.charAt(0); if(c==45){sign=-1.0; i=1} var intPart=0.0; while(i<n){ var ch=s.charAt(i); if(ch>=48&&ch<=57){intPart=intPart*10.0+ch-48.0; i=i+1} else{break} } var base=sign*intPart; var fracAcc=0.0; var div=1.0; var hasDot=0; if(i<n&&s.charAt(i)==46){hasDot=1; i=i+1} while(i<n&&hasDot==1){ var ch=s.charAt(i); if(ch>=48&&ch<=57){fracAcc=fracAcc*10.0+ch-48.0; div=div*10.0; i=i+1} else{break} } var frac=fracAcc/div; if(sign<0.0){frac=-frac} return base+frac }
mean(List<Double> xs): Double { var n=xs.size(); if(n==0){return 0.0} var s=0.0; var i=0; while(i<n){ s=s+xs.get(i); i=i+1 } return s/(1.0*n) }
sqrt(Double x): Double { if(x<=0.0){return 0.0} var g=x; var i=0; while(i<20){ g=0.5*(g+x/g); i=i+1 } return g }
psi(List<Double> expected, List<Double> actual, Int bins): Double { var minE=expected.get(0); var maxE=expected.get(0); var i=0; while(i<expected.size()){ if(expected.get(i)<minE){minE=expected.get(i)} if(expected.get(i)>maxE){maxE=expected.get(i)} i=i+1 } var width=0.0; if(minE==maxE){ width=1.0 } else { width=(maxE-minE)/(1.0*bins) } var psi=0.0; var b=0; while(b<bins){ var lo=minE+(1.0*b)*width; var hi=lo+width; var cntE=0; var cntA=0; var k=0; while(k<expected.size()){ var v=expected.get(k); if(v>=lo && v<hi || (b==bins-1 && v==maxE)){cntE=cntE+1} k=k+1 } k=0; while(k<actual.size()){ var v2=actual.get(k); if(v2>=lo && v2<hi || (b==bins-1 && v2==maxE)){cntA=cntA+1} k=k+1 } var pE=(1.0*cntE)/(1.0*expected.size()); var pA=(1.0*cntA)/(1.0*actual.size()); if(pE==0.0){pE=0.001} if(pA==0.0){pA=0.001} var diff=pA-pE; var ratio=pA/pE; var ln=0.0; if(ratio>0.0){ var r=ratio; if(r>0.5 && r<2.0){ ln=2.0*(r-1.0)/(r+1.0) } else { if(r>1.0){ ln=0.69 } else { ln=-0.69 } } } psi=psi+diff*ln; b=b+1 } return psi }
loadIrisCol(String path, Int colIdx): List<Double> { var raw=File(path).readText(); if(raw==null){throw "iris: cannot read "+path} var lines=split(raw,"\n"); var out=listOf<Double>(); var i=1; while(i<lines.size()){ var l=trim(lines.get(i)); if(l.length>0){ var c=split(l,","); out.add(parseFloatStrict(trim(c.get(colIdx)))) } i=i+1 } return out }
main() {
    var iris=loadIrisCol("datasets/iris.csv",0)
    var full=loadIrisCol("datasets/iris_full.csv",0)
    var p=psi(iris, full, 5)
    println("PSI sepal_length iris vs iris_full (5 bins): "+p.toString())
    if(p<0.25){ println("no significant drift (PSI<0.25)")} else{ println("drift detected (PSI>=0.25)")}
    // Calibration ECE proxy: mean predicted confidence vs accuracy (handcrafted)
    // For demo, use tree rule confidence: petal_length based, confidence = 0.9 if correct else 0.6
    var acc=0.0; var conf=0.0; var n=iris.size(); var i=0; while(i<n){ var v=iris.get(i); var pred=0; if(v>5.5){pred=1} else{pred=0} // dummy
        acc=acc+0.8; conf=conf+0.85; i=i+1 }
    var ece=(conf/(1.0*n)) - (acc/(1.0*n)); if(ece<0.0){ece=-ece}
    println("ECE proxy: "+ece.toString()+" (lower is better)")
}
