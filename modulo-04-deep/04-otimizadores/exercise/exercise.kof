// modulo-04-deep/04-otimizadores/lab.kof
// Adam optimizer + checkpoint persistence (JSON) — idiomático em 0.3.22 (List<Double> em record agora funciona).
// Source: shared/math.kof
// Target: JVM (json.encode/decode<T> + File)
sqrt(Double x): Double { if(x<=0.0){return 0.0} var g=x; var i=0; while(i<20){ g=0.5*(g+x/g); i=i+1 } return g }
powApprox(Double base, Int exp): Double { var r=1.0; var i=0; while(i<exp){ r=r*base; i=i+1 } return r }
class Adam(List<Double> params, List<Double> m, List<Double> v, Double lr, Double b1, Double b2, Double eps, List<Int> stepBox) {
    step(List<Double> grads): Int { if(grads.size()!=params.size()){throw "adam: grad size mismatch"} if(m.size()!=params.size()){throw "adam: m size mismatch"} var t=stepBox.get(0)+1; stepBox.set(0,t); var b1t=powApprox(b1,t); var b2t=powApprox(b2,t); var bc1=1.0-b1t; var bc2=1.0-b2t; var i=0; while(i<params.size()){ var g=grads.get(i); var mi=m.get(i)*b1+g*(1.0-b1); var vi=v.get(i)*b2+g*g*(1.0-b2); m.set(i,mi); v.set(i,vi); var mHat=mi/bc1; var vHat=vi/bc2; var denom=sqrt(vHat)+eps; var delta=lr*mHat/denom; params.set(i, params.get(i)-delta); i=i+1 } return 0 }
    getParam(Int i): Double { return params.get(i) }
    getStep(): Int { return stepBox.get(0) }
}
makeAdam(List<Double> initParams, Double lr): Adam { var n=initParams.size(); var p=listOf<Double>(); var mm=listOf<Double>(); var vv=listOf<Double>(); var i=0; while(i<n){ p.add(initParams.get(i)); mm.add(0.0); vv.add(0.0); i=i+1 } var box=listOf<Int>(); box.add(0); return Adam(p,mm,vv,lr,0.9,0.999,0.00000001,box) }
record Checkpoint(List<Double> params, Int step)
saveCheckpoint(String path, Adam opt): Int { var cp=Checkpoint(opt.params, opt.getStep()); var js=json.encode(cp); File(path).writeText(js); return 0 }
loadCheckpoint(String path): Checkpoint { var raw=File(path).readText(); if(raw==null){throw "checkpoint: cannot read "+path} return json.decode<Checkpoint>(raw) }
gradLoss(List<Double> params): List<Double> { var g=listOf<Double>(); var gx=2.0*(params.get(0)-5.0); var gy=2.0*(params.get(1)- -3.0); g.add(gx); g.add(gy); return g }
lossValue(List<Double> params): Double { var dx=params.get(0)-5.0; var dy=params.get(1)- -3.0; return dx*dx+dy*dy }
test "one adam step moves toward target" { var init=listOf<Double>(); init.add(0.0); init.add(0.0); var opt=makeAdam(init,0.2); var g=gradLoss(opt.params); var lossBefore=lossValue(opt.params); opt.step(g); var lossAfter=lossValue(opt.params); assert(lossAfter<lossBefore,"loss must decrease"); assert(opt.getParam(0)>0.0,"x moved positive"); assert(opt.getParam(1)<0.0,"y moved negative") }
test "adam 20 steps approaches target" { var init=listOf<Double>(); init.add(0.0); init.add(0.0); var opt=makeAdam(init,0.2); var i=0; while(i<20){ var g=gradLoss(opt.params); opt.step(g); i=i+1 } var dx=opt.getParam(0)-5.0; if(dx<0.0){dx=-dx} assert(dx<2.0,"x within 2.0"); var dy=opt.getParam(1)- -3.0; if(dy<0.0){dy=-dy} assert(dy<2.0,"y within 2.0"); var lv=lossValue(opt.params); assert(lv<5.0,"loss <5") }
test "checkpoint roundtrip exact" { var init=listOf<Double>(); init.add(1.0); init.add(2.0); var opt=makeAdam(init,0.1); var g=listOf<Double>(); g.add(0.5); g.add(-0.5); opt.step(g); var path="modulo-04-deep/04-otimizadores/test.ckpt.json"; saveCheckpoint(path,opt); var loaded=loadCheckpoint(path); var d0=loaded.params.get(0)-opt.getParam(0); if(d0<0.0){d0=-d0} assert(d0<0.0001,"param 0 recovery"); var d1=loaded.params.get(1)-opt.getParam(1); if(d1<0.0){d1=-d1} assert(d1<0.0001,"param 1 recovery"); assert(loaded.step==opt.getStep(),"step recovery"); File(path).delete() }
test "powApprox correctness" { var p=powApprox(2.0,3); var d=p-8.0; if(d<0.0){d=-d} assert(d<0.0001,"2^3=8"); var p2=powApprox(0.9,2); var d2=p2-0.81; if(d2<0.0){d2=-d2} assert(d2<0.0001,"0.9^2=0.81") }
test "gradLoss at target is zero" { var at=listOf<Double>(); at.add(5.0); at.add(-3.0); var g=gradLoss(at); assert(g.get(0)==0.0,"gx 0"); assert(g.get(1)==0.0,"gy 0"); var lv=lossValue(at); assert(lv==0.0,"loss 0") }
