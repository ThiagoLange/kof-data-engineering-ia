// modulo-04-deep/05-registry/lab.kof
// Model Registry: checkpoint + metrics + kof.log + kof.web serve (simulado).
// Target: JVM 0.4.10.
split(String s, String delim): List<String> { var out=listOf<String>(); var start=0; var n=s.length; var i=0; while(i<n){ if(s.charAt(i)==delim.charAt(0)){ out.add(s.substring(start,i)); start=i+1 } i=i+1 } out.add(s.substring(start,n)); return out }
trim(String s): String { var n=s.length; var start=0; while(start<n){ var c=s.charAt(start); if(c!=32&&c!=9&&c!=10&&c!=13){break} start=start+1 } var end=n; while(end>start){ var c=s.charAt(end-1); if(c!=32&&c!=9&&c!=10&&c!=13){break} end=end-1 } return s.substring(start,end) }
record ModelVersion(String modelId, String paramsCsv, Double accuracy, Int step)
paramsToCsv(List<Double> p): String { var s=""; var i=0; while(i<p.size()){ if(i>0){s=s+","} s=s+p.get(i).toString(); i=i+1 } return s }
loadIrisAcc(String path): Double { var raw=File(path).readText(); if(raw==null){return 0.0} var lines=split(raw,"\n"); var n=0; var i=1; while(i<lines.size()){ if(trim(lines.get(i)).length>0){n=n+1} i=i+1 } return 0.95 }
main() {
    var v1=ModelVersion("mlp-ir-iris-v1", paramsToCsv(listOf<Double>()), 0.95, 10)
    // simulate list with 2 versions
    var registry=listOf<ModelVersion>(); registry.add(v1)
    var v2=ModelVersion("mlp-ir-iris-v2", "0.1,0.2,0.3", 0.97, 20); registry.add(v2)
    println("registry size: "+registry.size().toString())
    var i=0; while(i<registry.size()){ var m=registry.get(i); log.info("model "+m.modelId+" acc="+m.accuracy.toString()+" step="+m.step.toString()); println("  "+m.modelId+" acc="+m.accuracy.toString()); i=i+1 }
    // promote best
    var best=registry.get(0); var k=1; while(k<registry.size()){ if(registry.get(k).accuracy>best.accuracy){best=registry.get(k)} k=k+1 }
    log.info("model promote "+best.modelId)
    println("promoted: "+best.modelId)
    // persist registry
    var sb=""; var j=0; while(j<registry.size()){ if(j>0){sb=sb+"\n"} sb=sb+json.encode(registry.get(j)); j=j+1 } var path="modulo-04-deep/05-registry/registry.jsonl"; File(path).writeText(sb); println("wrote "+path)
    // simulate web serve: log endpoint
    log.info("web serve /models/"+best.modelId+" -> 200")
    println("web: GET /models/"+best.modelId+" -> 200 {accuracy: "+best.accuracy.toString()+"}")
    File(path).delete(); println("cleaned")
}
