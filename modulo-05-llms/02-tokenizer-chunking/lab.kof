// modulo-05-llms/02-tokenizer-chunking/lab.kof
//
// Simple word/punctuation tokenizer (char scan, lowercase, vocab with
// frequencies) plus sliding-window document chunking with configurable
// overlap — by words and by characters. Reads datasets/docs.jsonl.
//
// Source: shared/strutils.kof
// Target: JVM (kof run; default target)

// ─── helpers (inline copies of shared/strutils.kof) ────────────────────

split(String s, String delim): List<String> {
    var out = listOf<String>()
    if (delim.length == 0) {
        out.add(s)
        return out
    }
    var start = 0
    var n = s.length
    var i = 0
    while (i < n) {
        if (s.charAt(i) == delim.charAt(0)) {
            out.add(s.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.add(s.substring(start, n))
    return out
}

trim(String s): String {
    var n = s.length
    var start = 0
    while (start < n) {
        var c = s.charAt(start)
        if (c != 32 && c != 9 && c != 10 && c != 13) { break }
        start = start + 1
    }
    var end = n
    while (end > start) {
        var c = s.charAt(end - 1)
        if (c != 32 && c != 9 && c != 10 && c != 13) { break }
        end = end - 1
    }
    return s.substring(start, end)
}

// ─── tokenizer ─────────────────────────────────────────────────────────

// isAlnum(c): ASCII letter or digit.
isAlnum(Int c): Int {
    if (c >= 97 && c <= 122) { return 1 }
    if (c >= 65 && c <= 90) { return 1 }
    if (c >= 48 && c <= 57) { return 1 }
    return 0
}

// tokenize(text): char scan producing lowercase word tokens; every
// punctuation char becomes its own token; whitespace separates.
tokenize(String text): List<String> {
    var out = listOf<String>()
    var n = text.length
    var i = 0
    var buf = ""
    while (i < n) {
        var c = text.charAt(i)
        if (isAlnum(c) == 1) {
            buf = buf + text.substring(i, i + 1)
        } else {
            if (buf.length > 0) {
                out.add(buf.toLowerCase())
                buf = ""
            }
            if (c != 32 && c != 9 && c != 10 && c != 13) {
                out.add(text.substring(i, i + 1))
            }
        }
        i = i + 1
    }
    if (buf.length > 0) {
        out.add(buf.toLowerCase())
    }
    return out
}

// wordSplit(text): whitespace-only split into raw words (no punctuation
// splitting, no lowercase) — used by word-level chunking.
wordSplit(String text): List<String> {
    var out = listOf<String>()
    var raw = split(text, " ")
    var n = raw.size()
    var i = 0
    while (i < n) {
        var w = trim(raw.get(i))
        if (w.length > 0) {
            out.add(w)
        }
        i = i + 1
    }
    return out
}

// ─── vocabulary ────────────────────────────────────────────────────────

record VocabEntry(String token, Int freq)

// buildVocab(tokens): insertion-ordered vocabulary with raw frequencies.
buildVocab(List<String> tokens): List<VocabEntry> {
    var vocab = listOf<VocabEntry>()
    var n = tokens.size()
    var i = 0
    while (i < n) {
        var t = tokens.get(i)
        var found = 0
        var j = 0
        var m = vocab.size()
        while (j < m) {
            var e = vocab.get(j)
            if (e.token == t) {
                vocab.set(j, VocabEntry(e.token, e.freq + 1))
                found = 1
                j = m
            } else {
                j = j + 1
            }
        }
        if (found == 0) {
            vocab.add(VocabEntry(t, 1))
        }
        i = i + 1
    }
    return vocab
}

// countTokens(text): token count of a single string.
countTokens(String text): Int {
    return tokenize(text).size()
}

// ─── chunking ──────────────────────────────────────────────────────────

// joinWords(words, start, end): join words[start, end) with single spaces.
joinWords(List<String> words, Int start, Int end): String {
    var sb = ""
    var i = start
    while (i < end) {
        if (i > start) {
            sb = sb + " "
        }
        sb = sb + words.get(i)
        i = i + 1
    }
    return sb
}

// chunkByWords(text, window, overlap): sliding window over whitespace
// words. step = window - overlap. Last chunk may be shorter. Throws on
// invalid window/overlap.
chunkByWords(String text, Int window, Int overlap): List<String> {
    if (window <= 0) { throw "chunk: window must be > 0" }
    if (overlap < 0) { throw "chunk: overlap must be >= 0" }
    if (overlap >= window) { throw "chunk: overlap must be < window" }
    var words = wordSplit(text)
    var n = words.size()
    var out = listOf<String>()
    if (n == 0) { return out }
    var step = window - overlap
    var start = 0
    while (start < n) {
        var end = start + window
        if (end > n) { end = n }
        out.add(joinWords(words, start, end))
        if (end == n) { start = n }
        else { start = start + step }
    }
    return out
}

// chunkByChars(text, window, overlap): sliding window over characters.
chunkByChars(String text, Int window, Int overlap): List<String> {
    if (window <= 0) { throw "chunk: window must be > 0" }
    if (overlap < 0) { throw "chunk: overlap must be >= 0" }
    if (overlap >= window) { throw "chunk: overlap must be < window" }
    var n = text.length
    var out = listOf<String>()
    if (n == 0) { return out }
    var step = window - overlap
    var start = 0
    while (start < n) {
        var end = start + window
        if (end > n) { end = n }
        out.add(text.substring(start, end))
        if (end == n) { start = n }
        else { start = start + step }
    }
    return out
}

// ─── dataset access ────────────────────────────────────────────────────

record Doc(String id, String title, String body, String lang)

parseDocs(String path): List<Doc> {
    var raw = File(path).readText()
    if (raw == null) { throw "docs: cannot read " + path }
    var lines = split(raw, "\n")
    var out = listOf<Doc>()
    var n = lines.size()
    var i = 0
    while (i < n) {
        var line = trim(lines.get(i))
        if (line.length > 0) {
            try {
                out.add(json.decode<Doc>(line))
            } catch (String e) {
                println("skip line " + i.toString() + ": parse error")
            }
        }
        i = i + 1
    }
    return out
}

// ─── demo ──────────────────────────────────────────────────────────────

main() {
    var docs = parseDocs("datasets/docs.jsonl")
    println("docs: " + docs.size().toString())

    // tokenize + vocab over the whole corpus
    var corpus = listOf<String>()
    var allTokens = listOf<String>()
    var i = 0
    var n = docs.size()
    while (i < n) {
        var d = docs.get(i)
        var toks = tokenize(d.title + " " + d.body)
        println(d.id + " tokens=" + toks.size().toString())
        var j = 0
        while (j < toks.size()) {
            allTokens.add(toks.get(j))
            j = j + 1
        }
        corpus.add(d.title + ". " + d.body)
        i = i + 1
    }
    var vocab = buildVocab(allTokens)
    println("vocab size: " + vocab.size().toString())
    var k = 0
    while (k < vocab.size() && k < 5) {
        var e = vocab.get(k)
        println("  vocab[" + k.toString() + "] " + e.token + " x" + e.freq.toString())
        k = k + 1
    }

    // word-level chunking of the concatenated corpus
    var big = ""
    var c = 0
    while (c < corpus.size()) {
        if (c > 0) { big = big + " " }
        big = big + corpus.get(c)
        c = c + 1
    }
    var wchunks = chunkByWords(big, 8, 3)
    println("word chunks (window=8, overlap=3): " + wchunks.size().toString())
    var w = 0
    while (w < wchunks.size()) {
        println("  wchunk[" + w.toString() + "] (" + wordSplit(wchunks.get(w)).size().toString() + " words): " + wchunks.get(w))
        w = w + 1
    }

    // char-level chunking of the first doc body
    var cchunks = chunkByChars(docs.get(0).body, 30, 10)
    println("char chunks (window=30, overlap=10): " + cchunks.size().toString())
    var x = 0
    while (x < cchunks.size()) {
        println("  cchunk[" + x.toString() + "] (" + cchunks.get(x).length.toString() + " chars): " + cchunks.get(x))
        x = x + 1
    }
}
