// modulo-05-llms/03-cosine-similarity/lab.kof
//
// Cosine similarity engine: dot, norm, cosine, distance, top-k retrieval
// over static embeddings. Vectors are List<Double> (high-precision Double).
// Demonstrates pure vector math without external embeddings API.
//
// Source: shared/math.kof
// Target: JVM (kof run; default target)

// ─── math helpers (inline shared/math.kof) ───────────────────────────

sqrt(Double x): Double {
    if (x <= 0.0) { return 0.0 }
    var g = x
    var i = 0
    while (i < 20) { g = 0.5 * (g + x / g); i = i + 1 }
    return g
}

// ─── vector ops ──────────────────────────────────────────────────────

dot(List<Double> a, List<Double> b): Double {
    if (a.size() != b.size()) { throw "cosine: dim mismatch " + a.size().toString() + " vs " + b.size().toString() }
    if (a.size() == 0) { throw "cosine: empty vectors" }
    var s = 0.0
    var i = 0
    while (i < a.size()) { s = s + a.get(i) * b.get(i); i = i + 1 }
    return s
}

norm(List<Double> a): Double {
    return sqrt(dot(a, a))
}

cosineSimilarity(List<Double> a, List<Double> b): Double {
    var nA = norm(a)
    var nB = norm(b)
    if (nA == 0.0 || nB == 0.0) { throw "cosine: zero-norm vector" }
    var d = dot(a, b)
    return d / (nA * nB)
}

cosineDistance(List<Double> a, List<Double> b): Double {
    var sim = cosineSimilarity(a, b)
    return 1.0 - sim
}

// cosineSimilarityBatch: multiple candidates vs one query
cosineSimilarityBatch(List<List<Double>> candidates, List<Double> query): List<Double> {
    var out = listOf<Double>()
    var i = 0
    while (i < candidates.size()) { out.add(cosineSimilarity(candidates.get(i), query)); i = i + 1 }
    return out
}

// topK: indices of k highest similarities (descending). O(n*k) selection.
record ScoredIdx(Int idx, Double score)

topK(List<Double> scores, Int k): List<Int> {
    if (k <= 0) { throw "topK: k must be >0" }
    if (k > scores.size()) { k = scores.size() }
    // copy indices
    var remaining = listOf<Int>()
    var i = 0
    while (i < scores.size()) { remaining.add(i); i = i + 1 }
    var out = listOf<Int>()
    var t = 0
    while (t < k) {
        var bestPos = 0
        var bestScore = scores.get(remaining.get(0))
        var j = 1
        while (j < remaining.size()) {
            var idx = remaining.get(j)
            var sc = scores.get(idx)
            if (sc > bestScore) { bestScore = sc; bestPos = j }
            j = j + 1
        }
        var chosen = remaining.get(bestPos)
        out.add(chosen)
        // remove bestPos by rebuilding list
        var next = listOf<Int>()
        var r = 0
        while (r < remaining.size()) { if (r != bestPos) { next.add(remaining.get(r)) } r = r + 1 }
        remaining = next
        t = t + 1
    }
    return out
}

// ─── demo ──────────────────────────────────────────────────────────────

// ─── tests ─────────────────────────────────────────────────────────

test "identical vectors sim 1" {
    var a = listOf<Double>(); a.add(1.0); a.add(2.0); a.add(3.0)
    var b = listOf<Double>(); b.add(1.0); b.add(2.0); b.add(3.0)
    var s = cosineSimilarity(a,b)
    var d = s - 1.0
    if (d < 0.0) { d = -d }
    assert(d < 0.0001, "identical 1.0 got " + s.toString())
}

test "orthogonal sim 0" {
    var a = listOf<Double>(); a.add(1.0); a.add(0.0)
    var b = listOf<Double>(); b.add(0.0); b.add(1.0)
    var s = cosineSimilarity(a,b)
    var d = s - 0.0
    if (d < 0.0) { d = -d }
    assert(d < 0.0001, "ortho 0 got " + s.toString())
}

test "scaled identical still 1" {
    var a = listOf<Double>(); a.add(1.0); a.add(1.0)
    var b = listOf<Double>(); b.add(3.0); b.add(3.0)
    var s = cosineSimilarity(a,b)
    var d = s - 1.0
    if (d < 0.0) { d = -d }
    assert(d < 0.0001, "scaled 1.0 got " + s.toString())
}

test "opposite vectors sim -1" {
    var a = listOf<Double>(); a.add(1.0); a.add(0.0)
    var b = listOf<Double>(); b.add(-1.0); b.add(0.0)
    var s = cosineSimilarity(a,b)
    var d = s - -1.0
    if (d < 0.0) { d = -d }
    assert(d < 0.0001, "-1 got " + s.toString())
    var dist = cosineDistance(a,b)
    var dd = dist - 2.0
    if (dd < 0.0) { dd = -dd }
    assert(dd < 0.0001, "dist 2 got " + dist.toString())
}

test "dim mismatch throws" {
    var a = listOf<Double>(); a.add(1.0); a.add(0.0)
    var b = listOf<Double>(); b.add(1.0)
    var threw = 0
    try { var s = cosineSimilarity(a,b) } catch (String e) { threw = 1 }
    assert(threw == 1, "must throw on dim mismatch")
}

test "zero-norm throws" {
    var a = listOf<Double>(); a.add(0.0); a.add(0.0)
    var b = listOf<Double>(); b.add(1.0); b.add(0.0)
    var threw = 0
    try { var s = cosineSimilarity(a,b) } catch (String e) { threw = 1 }
    assert(threw == 1, "must throw on zero norm")
}

test "topK selects highest" {
    var scores = listOf<Double>()
    scores.add(0.1); scores.add(0.9); scores.add(0.3); scores.add(0.8)
    var top = topK(scores, 2)
    assert(top.size() == 2, "top2 size")
    assert(top.get(0) == 1, "first best idx 1")
    assert(top.get(1) == 3, "second best idx 3")
    // verify order: scores descending
    assert(scores.get(top.get(0)) > scores.get(top.get(1)), "descending")
}

test "batch scoring" {
    var cands = listOf<List<Double>>()
    var v1 = listOf<Double>(); v1.add(1.0); v1.add(0.0); cands.add(v1)
    var v2 = listOf<Double>(); v2.add(0.0); v2.add(1.0); cands.add(v2)
    var q = listOf<Double>(); q.add(1.0); q.add(0.0)
    var sims = cosineSimilarityBatch(cands, q)
    assert(sims.size() == 2, "batch 2")
    var d0 = sims.get(0) - 1.0
    if (d0 < 0.0) { d0 = -d0 }
    assert(d0 < 0.0001, "query vs v1 1.0")
    var d1 = sims.get(1) - 0.0
    if (d1 < 0.0) { d1 = -d1 }
    assert(d1 < 0.0001, "query vs v2 0")
}
