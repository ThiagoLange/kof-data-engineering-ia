// modulo-05-llms/07-avaliacao-llm/lab.kof
// Avaliação LLM: latency/tokens + ECE real para cosine.
// Target: JVM 0.4.7.
split(String s, String delim): List<String> { var out=listOf<String>(); var start=0; var n=s.length; var i=0; while(i<n){ if(s.charAt(i)==delim.charAt(0)){ out.add(s.substring(start,i)); start=i+1 } i=i+1 } out.add(s.substring(start,n)); return out }
trim(String s): String { var n=s.length; var start=0; while(start<n){ var c=s.charAt(start); if(c!=32&&c!=9&&c!=10&&c!=13){break} start=start+1 } var end=n; while(end>start){ var c=s.charAt(end-1); if(c!=32&&c!=9&&c!=10&&c!=13){break} end=end-1 } return s.substring(start,end) }
wordSplit(String t): List<String> { var out=listOf<String>(); var raw=split(t," "); var i=0; while(i<raw.size()){ var w=trim(raw.get(i)); if(w.length>0){out.add(w)} i=i+1 } return out }
record LLMMetrics(Int tokens, Int latencyMs, Double confidence)
fakeLLM(String prompt): LLMMetrics { var toks=wordSplit(prompt).size(); var lat=toks*2; var conf=0.9; if(indexOf(prompt,"unknown")!=-1){ conf=0.6 } return LLMMetrics(toks, lat, conf) }
indexOf(String s, String needle): Int { if(needle.length==0){return 0} var n=s.length; var m=needle.length; if(m>n){return -1} var limit=n-m; var i=0; while(i<=limit){ var match=1; var j=0; while(j<m){ if(s.charAt(i+j)!=needle.charAt(j)){match=0; j=m} else{j=j+1} } if(match==1){return i} i=i+1 } return -1 }
ece(List<Double> confidences, List<Int> correct): Double { var n=confidences.size(); if(n==0){return 0.0} var bins=5; var ece=0.0; var b=0; while(b<bins){ var lo=(1.0*b)/(1.0*bins); var hi=(1.0*(b+1))/(1.0*bins); var cnt=0; var sumConf=0.0; var sumAcc=0.0; var i=0; while(i<n){ var c=confidences.get(i); if(c>=lo && c<hi || (b==bins-1 && c==1.0)){ cnt=cnt+1; sumConf=sumConf+c; if(correct.get(i)==1){ sumAcc=sumAcc+1.0 } } i=i+1 } if(cnt>0){ var avgConf=sumConf/(1.0*cnt); var avgAcc=sumAcc/(1.0*cnt); var diff=avgConf-avgAcc; if(diff<0.0){diff=-diff} ece=ece+diff*(1.0*cnt)/(1.0*n) } b=b+1 } return ece }
test "fakeLLM tokens" { var m=fakeLLM("hello world"); assert(m.tokens==2,"2") }
test "ece perfect calibration 0" { var confs=listOf<Double>(); confs.add(0.9); confs.add(0.9); var cor=listOf<Int>(); cor.add(1); cor.add(1); var e=ece(confs,cor); assert(e<0.2,"ece small") }
test "ece miscalibrated larger" { var confs=listOf<Double>(); confs.add(0.9); var cor=listOf<Int>(); cor.add(0); var e=ece(confs,cor); assert(e>0.5,"ece large") }
