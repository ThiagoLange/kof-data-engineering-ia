// modulo-05-llms/01-llm-client/exercise.kof
//
// Run with: kof test modulo-05-llms/01-llm-client/exercise.kof
//
// Self-contained copy of lab.kof with assertions at the bottom. All tests
// run offline against FakeTransport/ErrorTransport — no network, no key.

// ─── domain ────────────────────────────────────────────────────────────

record ChatMessage(String role, String content)

interface Transport {
    send(String url, String body, String headers): String
}

class HttpTransport implements Transport {
    String apiKey

    constructor(String apiKey) {
        this.apiKey = apiKey
    }

    send(String url, String body, String headers): String {
        var allHeaders = headers + "\nAuthorization: Bearer " + this.apiKey
        return http.post(url, body, allHeaders)
    }
}

class FakeTransport implements Transport {
    Int failsLeft
    Int calls
    String respBody

    constructor(Int failsLeft, String respBody) {
        this.failsLeft = failsLeft
        this.respBody = respBody
    }

    send(String url, String body, String headers): String {
        this.calls = this.calls + 1
        if (this.failsLeft > 0) {
            this.failsLeft = this.failsLeft - 1
            throw "HTTP 500: scripted failure"
        }
        return this.respBody
    }
}

class ErrorTransport implements Transport {
    String err
    Int calls

    constructor(String err) {
        this.err = err
    }

    send(String url, String body, String headers): String {
        this.calls = this.calls + 1
        throw this.err
    }
}

extractJsonString(String body, String key): String {
    var pat = "\"" + key + "\":\""
    var n = body.length
    var m = pat.length
    var i = 0
    while (i <= n - m) {
        var match = 1
        var j = 0
        while (j < m) {
            if (body.charAt(i + j) != pat.charAt(j)) {
                match = 0
                j = m
            } else {
                j = j + 1
            }
        }
        if (match == 1) {
            var sb = ""
            var k = i + m
            while (k < n) {
                var c = body.charAt(k)
                if (c == 92) {
                    // backslash escape: translate the common ones
                    k = k + 1
                    if (k < n) {
                        var e = body.charAt(k)
                        if (e == 110) {
                            sb = sb + "\n"
                        } else if (e == 116) {
                            sb = sb + "\t"
                        } else {
                            sb = sb + body.substring(k, k + 1)
                        }
                    }
                } else if (c == 34) {
                    return sb
                } else {
                    sb = sb + body.substring(k, k + 1)
                }
                k = k + 1
            }
            return sb
        }
        i = i + 1
    }
    throw "json: key not found: " + key
}

isRetryable(String e): Int {
    if (e.length >= 6) {
        if (e.substring(0, 6) == "HTTP 5") {
            return 1
        }
    }
    if (e.length >= 8) {
        if (e.substring(0, 8) == "HTTP 429") {
            return 1
        }
    }
    return 0
}

class LLMClient(Transport t, String baseUrl, Int maxRetries) {
    complete(List<ChatMessage> messages): String {
        var body = "{\"model\":\"kof-demo\",\"messages\":["
        var i = 0
        var n = messages.size()
        while (i < n) {
            var msg = messages.get(i)
            if (i > 0) {
                body = body + ","
            }
            body = body + "{\"role\":\"" + msg.role + "\",\"content\":\""
            body = body + msg.content + "\"}"
            i = i + 1
        }
        body = body + "]}"
        var attempt = 0
        while (attempt <= this.maxRetries) {
            try {
                var resp = this.t.send(this.baseUrl, body, "Content-Type: application/json")
                return extractJsonString(resp, "content")
            } catch (String e) {
                if (isRetryable(e) == 0) {
                    throw e
                }
                if (attempt == this.maxRetries) {
                    throw e
                }
                var delay = 50
                var k = 0
                while (k < attempt) {
                    delay = delay * 2
                    k = k + 1
                }
                time.sleep(delay)
                attempt = attempt + 1
            }
        }
        throw "llm: unreachable retry state"
    }
}

// ─── tests ─────────────────────────────────────────────────────────────

test "retry succeeds after 2 transient failures" {
    var resp = "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"retried ok\"}}]}"
    var fake = new FakeTransport(2, resp)
    var client = new LLMClient(fake, "https://api.example.com/v1/chat/completions", 3)
    var msgs = listOf<ChatMessage>()
    msgs.add(ChatMessage("user", "hi"))
    var out = client.complete(msgs)
    assert(out == "retried ok", "must return scripted content")
    assert(fake.calls == 3, "expected 3 calls (2 failures + 1 success), got " + fake.calls.toString())
}

test "non-retryable 4xx fails fast" {
    var errT = new ErrorTransport("HTTP 400: invalid request")
    var client = new LLMClient(errT, "https://api.example.com/v1/chat/completions", 3)
    var msgs = listOf<ChatMessage>()
    msgs.add(ChatMessage("user", "hi"))
    var threw = 0
    try {
        var bad = client.complete(msgs)
        assert(bad == "", "should not reach")
    } catch (String e) {
        threw = 1
        assert(e == "HTTP 400: invalid request", "must surface the transport error")
    }
    assert(threw == 1, "must throw on 4xx")
    assert(errT.calls == 1, "4xx must not be retried; got " + errT.calls.toString() + " calls")
}

test "max retries exceeded gives up" {
    var resp = "{}"
    var fake = new FakeTransport(10, resp)
    var client = new LLMClient(fake, "https://api.example.com/v1/chat/completions", 2)
    var msgs = listOf<ChatMessage>()
    msgs.add(ChatMessage("user", "hi"))
    var threw = 0
    try {
        var bad = client.complete(msgs)
        assert(bad == "", "should not reach")
    } catch (String e) {
        threw = 1
    }
    assert(threw == 1, "must throw when retries are exhausted")
    assert(fake.calls == 3, "expected 1 + 2 retries = 3 calls, got " + fake.calls.toString())
}

test "429 is retryable" {
    var errT = new ErrorTransport("HTTP 429: rate limited")
    var client = new LLMClient(errT, "https://api.example.com/v1/chat/completions", 1)
    var msgs = listOf<ChatMessage>()
    msgs.add(ChatMessage("user", "hi"))
    var threw = 0
    try {
        var bad = client.complete(msgs)
        assert(bad == "", "should not reach")
    } catch (String e) {
        threw = 1
        assert(e == "HTTP 429: rate limited", "must surface the rate-limit error")
    }
    assert(threw == 1, "must throw after retrying 429")
}

test "missing API key does not break the offline path" {
    // The lab guards the live demo with an empty-key check; the offline
    // client path (FakeTransport) must work regardless of any key.
    var apiKey = secrets.get("LLM_API_KEY", "")
    assert(apiKey.length == 0, "test env must not set LLM_API_KEY")
    var resp = "{\"choices\":[{\"message\":{\"role\":\"assistant\",\"content\":\"offline answer\"}}]}"
    var fake = new FakeTransport(0, resp)
    var client = new LLMClient(fake, "https://api.example.com/v1/chat/completions", 1)
    var msgs = listOf<ChatMessage>()
    msgs.add(ChatMessage("user", "hi"))
    var out = client.complete(msgs)
    assert(out == "offline answer", "offline path must work without a key")
}

test "extractJsonString reads escaped content" {
    var body = "{\"choices\":[{\"message\":{\"content\":\"line1\\nline2\"}}]}"
    var out = extractJsonString(body, "content")
    assert(out == "line1\nline2", "must unescape \\n")
}
