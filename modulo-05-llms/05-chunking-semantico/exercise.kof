// modulo-05-llms/05-chunking-semantico/lab.kof
// Chunking semântico: por sentença (split em .) vs. por palavras (05-02).
// Target: JVM 0.3.2 compact.
split(String s, String delim): List<String> { var out=listOf<String>(); var start=0; var n=s.length; var i=0; while(i<n){ if(s.charAt(i)==delim.charAt(0)){ out.add(s.substring(start,i)); start=i+1 } i=i+1 } out.add(s.substring(start,n)); return out }
trim(String s): String { var n=s.length; var start=0; while(start<n){ var c=s.charAt(start); if(c!=32&&c!=9&&c!=10&&c!=13){break} start=start+1 } var end=n; while(end>start){ var c=s.charAt(end-1); if(c!=32&&c!=9&&c!=10&&c!=13){break} end=end-1 } return s.substring(start,end) }
wordSplit(String t): List<String> { var out=listOf<String>(); var raw=split(t," "); var i=0; while(i<raw.size()){ var w=trim(raw.get(i)); if(w.length>0){out.add(w)} i=i+1 } return out }
chunkByWords(String text, Int window, Int overlap): List<String> { if(window<=0){throw "chunk: window>0"} if(overlap>=window){throw "chunk: overlap<window"} var words=wordSplit(text); var n=words.size(); var out=listOf<String>(); if(n==0){return out} var step=window-overlap; var start=0; while(start<n){ var end=start+window; if(end>n){end=n} var sb=""; var i=start; while(i<end){ if(i>start){sb=sb+" "} sb=sb+words.get(i); i=i+1 } out.add(sb); if(end==n){start=n} else{start=start+step} } return out }
chunkBySentence(String text): List<String> { var parts=split(text,"."); var out=listOf<String>(); var i=0; while(i<parts.size()){ var s=trim(parts.get(i)); if(s.length>0){out.add(s+".")} i=i+1 } return out }
chunkSemantic(String text, Int maxWords): List<String> { var sents=chunkBySentence(text); var out=listOf<String>(); var cur=""; var curW=0; var i=0; while(i<sents.size()){ var sent=sents.get(i); var w=wordSplit(sent).size(); if(curW+w>maxWords && curW>0){ out.add(trim(cur)); cur=sent; curW=w } else{ if(cur.length>0){cur=cur+" "+sent} else{cur=sent} curW=curW+w } i=i+1 } if(trim(cur).length>0){out.add(trim(cur))} return out }
main() {
    var text="Kof is a statically typed language. It targets JVM and Native. It emphasizes clean syntax. Data engineering pipelines ingest transform and serve."
    var byWords=chunkByWords(text, 6, 2)
    println("byWords 6/2: "+byWords.size().toString()+" chunks")
    var i=0; while(i<byWords.size()){ println("  w"+i.toString()+": "+byWords.get(i)); i=i+1 }
    var bySent=chunkBySentence(text)
    println("bySentence: "+bySent.size().toString()+" sents")
    var j=0; while(j<bySent.size()){ println("  s"+j.toString()+": "+bySent.get(j)); j=j+1 }
    var semantic=chunkSemantic(text, 10)
    println("semantic maxWords 10: "+semantic.size().toString()+" chunks")
    var k=0; while(k<semantic.size()){ println("  sem"+k.toString()+": "+semantic.get(k)); k=k+1 }
}


test "chunkBySentence splits on dot" { var c=chunkBySentence("a. b. c."); assert(c.size()==3,"3") }
test "chunkSemantic respects maxWords" { var t="hello world. foo bar baz qux. another sentence here."; var c=chunkSemantic(t,4); assert(c.size()>=2,"at least 2") }
test "chunkByWords 6/2 sizes" { var c=chunkByWords("a b c d e f g h",6,2); assert(c.size()==2,"2 chunks") }
