// shared/env.kof
// Environment-variable helpers. Kof exposes OS env through the runtime;
// secrets.get is the canonical surface for reading configuration.
//
// envOr(key, fallback): returns the env value or a fallback. Never throws
// on missing keys — missing env is a normal condition in dev/test.
envOr(String key, String fallback): String {
    var v = secrets.get(key, null)
    if (v == null) {
        return fallback
    }
    return v
}

// requireEnv(key): returns the env value or throws a descriptive error.
// Use only in code paths where the env var is strictly required (e.g., LLM keys).
requireEnv(String key): String {
    var v = secrets.get(key, null)
    if (v == null) {
        throw "required env var missing: " + key
    }
    return v
}