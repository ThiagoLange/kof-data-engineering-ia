// shared/numberparse.kof
// Strict numeric parsing.
//
// Idiomatic strategy (per training/idioms/errors.md): throw a String on bad
// input rather than return a sentinel. There is no Option<T>/Result<T> in
// the language today.
//
// COMPILER WORKAROUNDS (Kof 0.1.3-beta JVM backend):
//
// 1. `x = x * 10.0 + (ch - 48).toDouble()` triggers COMP002 (asm frame
//    crash). Use `x = x * 10.0 + ch - 48.0` — keep rhs purely Double,
//    avoid .toDouble() inside if branches of while loops.
//
// 3. `println(parseFloatStrict(...))` combined with a try/catch around
//    another parseFloatStrict in the same main produces a VerifyError
//    ("Bad type on operand stack"). Workaround: assign to a local first
//    (`var a = parseFloatStrict(...); println(a)`).
//
// 2. Nullable return types on functions (Int?, Double?) are not supported
//    in 0.1.3-beta — the type system supports nullable declarations on
//    local/field variables only (see learn/13-nullability.md).
//
// WORKAROUND: parseIntSafe / parseFloatSafe wrap strict parsers in
// try/catch for call sites where absence is normal (CSV cells).
parseIntStrict(String s): Int {
    if (s == null) { throw "parseInt: null input" }
    var n = s.length
    if (n == 0) { throw "parseInt: empty input" }
    var i = 0
    var sign = 1
    var c = s.charAt(0)
    if (c == 45) { sign = -1; i = 1 }
    else if (c == 43) { i = 1 }
    if (i >= n) { throw "parseInt: sign only" }
    var acc = 0
    while (i < n) {
        var ch = s.charAt(i)
        if (ch < 48 || ch > 57) { throw "parseInt: invalid digit" }
        acc = acc * 10 + (ch - 48)
        i = i + 1
    }
    return sign * acc
}

parseFloatStrict(String s): Double {
    if (s == null) { throw "parseFloat: null input" }
    var n = s.length
    if (n == 0) { throw "parseFloat: empty input" }
    var i = 0
    var sign = 1.0
    var c = s.charAt(0)
    if (c == 45) { sign = -1.0; i = 1 }
    else if (c == 43) { i = 1 }
    if (i >= n) { throw "parseFloat: sign only" }
    var intPart = 0.0
    var sawDigit = 0
    while (i < n) {
        var ch = s.charAt(i)
        if (ch >= 48 && ch <= 57) {
            intPart = intPart * 10.0 + ch - 48.0
            sawDigit = 1
            i = i + 1
        } else { break }
    }
    var base = sign * intPart
    var fracAcc = 0.0
    var div = 1.0
    var hasDot = 0
    if (i < n) {
        if (s.charAt(i) == 46) {
            hasDot = 1
            i = i + 1
        }
    }
    while (i < n && hasDot == 1) {
        var ch = s.charAt(i)
        if (ch >= 48 && ch <= 57) {
            fracAcc = fracAcc * 10.0 + ch - 48.0
            div = div * 10.0
            i = i + 1
        } else { break }
    }
    if (sawDigit == 0 && hasDot == 0) { throw "parseFloat: no digits" }
    if (i < n) { throw "parseFloat: trailing garbage" }
    var frac = fracAcc / div
    var value = base + frac
    return value
}

parseIntSafe(String s, Int fallback): Int {
    try { return parseIntStrict(s) } catch (String e) { return fallback }
}

parseFloatSafe(String s, Double fallback): Double {
    try { return parseFloatStrict(s) } catch (String e) { return fallback }
}