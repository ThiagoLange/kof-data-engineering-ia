// shared/strutils.kof
// String utilities used across labs.
// Target: JVM (works on Native/JS where indicated; documented per function).

// indexOf(haystack, needle): first index of needle in haystack, or -1 if absent.
// Pure linear scan — no platform dependency.
indexOf(String s, String needle): Int {
    if (needle.length == 0) {
        return 0
    }
    var n = s.length
    var m = needle.length
    if (m > n) {
        return -1
    }
    var limit = n - m
    var i = 0
    while (i <= limit) {
        var match = 1
        var j = 0
        while (j < m) {
            if (s.charAt(i + j) != needle.charAt(j)) {
                match = 0
                j = m
            } else {
                j = j + 1
            }
        }
        if (match == 1) {
            return i
        }
        i = i + 1
    }
    return -1
}

// split(s, delim): split a string by a single-character delimiter into a List<String>.
// Empty fields are preserved (",,a," -> ["", "", "a", ""]).
split(String s, String delim): List<String> {
    var out = listOf<String>()
    if (delim.length == 0) {
        out.add(s)
        return out
    }
    var start = 0
    var n = s.length
    var i = 0
    while (i < n) {
        if (s.charAt(i) == delim.charAt(0)) {
            out.add(s.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.add(s.substring(start, n))
    return out
}

// trim(s): remove leading and trailing ASCII whitespace.
trim(String s): String {
    var n = s.length
    var start = 0
    while (start < n) {
        var c = s.charAt(start)
        if (c != 32 && c != 9 && c != 10 && c != 13) {
            break
        }
        start = start + 1
    }
    var end = n
    while (end > start) {
        var c = s.charAt(end - 1)
        if (c != 32 && c != 9 && c != 10 && c != 13) {
            break
        }
        end = end - 1
    }
    return s.substring(start, end)
}

// equals(a, b): null-safe string equality.
equals(String a, String b): Bool {
    if (a == null && b == null) {
        return true
    }
    if (a == null || b == null) {
        return false
    }
    return a == b
}