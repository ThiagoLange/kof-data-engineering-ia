// modulo-01-fundamentos/01-parser-csv-streamed/lab.kof
//
// Streamed CSV/TSV parser. Reads line-by-line (in-memory split on '\n')
// and converts cells to typed Records. Throws on malformed input; uses
// parseIntSafe / parseFloatSafe for optional cells.
//
// Source: shared/strutils.kof, shared/numberparse.kof
// Target: JVM (kof run; default target)

// ─── helpers (inline copies of shared/*.kof) ───────────────────────────

// split(s, delim): single-char delimiter; preserves empty fields.
split(String s, String delim): List<String> {
    var out = listOf<String>()
    if (delim.length == 0) {
        out.add(s)
        return out
    }
    var start = 0
    var n = s.length
    var i = 0
    while (i < n) {
        if (s.charAt(i) == delim.charAt(0)) {
            out.add(s.substring(start, i))
            start = i + 1
        }
        i = i + 1
    }
    out.add(s.substring(start, n))
    return out
}

// trim ASCII whitespace.
trim(String s): String {
    var n = s.length
    var start = 0
    while (start < n) {
        var c = s.charAt(start)
        if (c != 32 && c != 9 && c != 10 && c != 13) { break }
        start = start + 1
    }
    var end = n
    while (end > start) {
        var c = s.charAt(end - 1)
        if (c != 32 && c != 9 && c != 10 && c != 13) { break }
        end = end - 1
    }
    return s.substring(start, end)
}

parseIntStrict(String s): Int {
    if (s == null) { throw "parseInt: null input" }
    var n = s.length
    if (n == 0) { throw "parseInt: empty input" }
    var i = 0
    var sign = 1
    var c = s.charAt(0)
    if (c == 45) { sign = -1; i = 1 }
    else if (c == 43) { i = 1 }
    if (i >= n) { throw "parseInt: sign only" }
    var acc = 0
    while (i < n) {
        var ch = s.charAt(i)
        if (ch < 48 || ch > 57) { throw "parseInt: invalid digit" }
        acc = acc * 10 + (ch - 48)
        i = i + 1
    }
    return sign * acc
}

parseFloatStrict(String s): Double {
    if (s == null) { throw "parseFloat: null input" }
    var n = s.length
    if (n == 0) { throw "parseFloat: empty input" }
    var i = 0
    var sign = 1.0
    var c = s.charAt(0)
    if (c == 45) { sign = -1.0; i = 1 }
    else if (c == 43) { i = 1 }
    if (i >= n) { throw "parseFloat: sign only" }
    var intPart = 0.0
    var sawDigit = 0
    while (i < n) {
        var ch = s.charAt(i)
        if (ch >= 48 && ch <= 57) {
            intPart = intPart * 10.0 + ch - 48.0
            sawDigit = 1
            i = i + 1
        } else { break }
    }
    var base = sign * intPart
    var fracAcc = 0.0
    var div = 1.0
    var hasDot = 0
    if (i < n) {
        if (s.charAt(i) == 46) {
            hasDot = 1
            i = i + 1
        }
    }
    while (i < n && hasDot == 1) {
        var ch = s.charAt(i)
        if (ch >= 48 && ch <= 57) {
            fracAcc = fracAcc * 10.0 + ch - 48.0
            div = div * 10.0
            i = i + 1
        } else { break }
    }
    if (sawDigit == 0 && hasDot == 0) { throw "parseFloat: no digits" }
    if (i < n) { throw "parseFloat: trailing garbage" }
    var frac = fracAcc / div
    var value = base + frac
    return value
}

parseIntSafe(String s, Int fallback): Int {
    try { return parseIntStrict(s) } catch (String e) { return fallback }
}

parseFloatSafe(String s, Double fallback): Double {
    try { return parseFloatStrict(s) } catch (String e) { return fallback }
}

// isEmpty cell predicate: empty or whitespace-only == absent.
isEmptyCell(String s): Int {
    var t = trim(s)
    return ifEmpty(t)
}

ifEmpty(String s): Int {
    if (s.length == 0) { return 1 }
    return 0
}

// ─── domain ────────────────────────────────────────────────────────────

// Record representing one CSV row of the employees schema.
// Field types are Int or Double; absent cells become a documented sentinel
// (id=0, age=-1, salary=0.0) set explicitly by the parser. The schema is
// validated against the header row.
record Employee(
    Int id,
    Int age,
    Double salary,
    Int hasName,
    String name,
    String city
)

// parseHeader(line): returns the column count (and validates emptiness).
parseHeader(String line): Int {
    var cols = split(line, ",")
    return cols.size()
}

// parseRow(line, expectedCols): parses one row. Throws on column count
// mismatch or unparseable id/salary. Optional age uses parseIntSafe.
parseRow(String line, Int expectedCols): Employee {
    var cols = split(line, ",")
    if (cols.size() != expectedCols) {
        throw "csv: column count mismatch (expected " + expectedCols.toString() + ", got " + cols.size().toString() + ")"
    }
    // id is required and must parse strictly
    var id = parseIntStrict(trim(cols.get(0)))
    // name is optional in display; we keep the cell as-is
    var name = trim(cols.get(1))
    var hasName = ifEmpty(name)
    // age is optional -> -1 sentinel; documented in README
    var age = parseIntSafe(trim(cols.get(2)), -1)
    // city is optional string (kept as-is, possibly empty)
    var city = trim(cols.get(3))
    // salary is optional Double -> 0.0 sentinel; documented in README
    var salary = parseFloatSafe(trim(cols.get(4)), 0.0)
    return Employee(id, age, salary, hasName, name, city)
}

// readCsv(path): reads a CSV file with header, returns List<Employee>.
readCsv(String path): List<Employee> {
    var raw = File(path).readText()
    if (raw == null) {
        throw "csv: cannot read file: " + path
    }
    // Stream-line iteration via in-memory split on '\n'. Real streaming
    // requires Lab 1.4 binary I/O; this is the entry-level approach.
    var lines = split(raw, "\n")
    var out = listOf<Employee>()
    var n = lines.size()
    if (n == 0) { return out }
    // The first line is the header.
    var expectedCols = parseHeader(lines.get(0))
    var i = 1
    while (i < n) {
        var line = trim(lines.get(i))
        // skip blank lines (e.g., trailing \n)
        if (line.length > 0) {
            out.add(parseRow(line, expectedCols))
        }
        i = i + 1
    }
    return out
}

// ─── demo ──────────────────────────────────────────────────────────────

main() {
    var rows = readCsv("datasets/employees.csv")
    println("parsed rows: " + rows.size().toString())
    var i = 0
    var n = rows.size()
    while (i < n) {
        var r = rows.get(i)
        println(r.id.toString() + " | name=[" + r.name + "] age=" + r.age.toString() + " city=" + r.city + " salary=" + r.salary.toString())
        i = i + 1
    }
}