// modulo-00-setup/01-kof-toolchain/lab.kof
//
// Setup verification: checks that the Kof toolchain is correctly installed.
// Demonstrates kof version, kof info, kof check and File I/O sanity.
// Run this lab first; if it passes, the rest of the training will compile.
//
// Source: — (stdlib only, no shared helpers)
// Target: JVM (default)

// minimal demo: File readText + parse helpers
split(String s, String delim): List<String> {
    var out = listOf<String>()
    if (delim.length == 0) { out.add(s); return out }
    var start = 0
    var n = s.length
    var i = 0
    while (i < n) { if (s.charAt(i) == delim.charAt(0)) { out.add(s.substring(start, i)); start = i + 1 } i = i + 1 }
    out.add(s.substring(start, n))
    return out
}

main() {
    println("Kof toolchain check")
    println("  File I/O: reading datasets/employees.csv")
    var raw = File("datasets/employees.csv").readText()
    if (raw == null) { throw "setup: cannot read datasets/employees.csv (run from repo root)" }
    var lines = split(raw, "\n")
    println("  lines in employees.csv: " + lines.size().toString())
    // Verify that all expected datasets exist
    var datasets = listOf<String>()
    datasets.add("datasets/employees.csv")
    datasets.add("datasets/iris.csv")
    datasets.add("datasets/iris_full.csv")
    datasets.add("datasets/houses.tsv")
    datasets.add("datasets/customers.jsonl")
    datasets.add("datasets/transactions.jsonl")
    datasets.add("datasets/docs.jsonl")
    datasets.add("datasets/classification_eval.jsonl")
    var ok = 0
    var i = 0
    while (i < datasets.size()) {
        var p = datasets.get(i)
        var t = File(p).readText()
        if (t != null) {
            println("  OK " + p)
            ok = ok + 1
        } else {
            println("  MISSING " + p)
        }
        i = i + 1
    }
    println("datasets found: " + ok.toString() + "/" + datasets.size().toString())
    if (ok != datasets.size()) { throw "setup: missing datasets" }
    println("setup OK — run: kof test <exercise> | bash scripts/run-tests.sh")
}
