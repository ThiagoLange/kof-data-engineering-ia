// modulo-07-integracao/01-pipeline-batch/lab.kof
// Pipeline batch end-to-end: CSV → join → GroupBy → SVG/HTML report.
// Compõe Labs 01-01, 02-02, 02-03, 02-04 em único fluxo batch.
// Target: JVM 0.4.7.
split(String s, String delim): List<String> { var out=listOf<String>(); var start=0; var n=s.length; var i=0; while(i<n){ if(s.charAt(i)==delim.charAt(0)){ out.add(s.substring(start,i)); start=i+1 } i=i+1 } out.add(s.substring(start,n)); return out }
trim(String s): String { var n=s.length; var start=0; while(start<n){ var c=s.charAt(start); if(c!=32&&c!=9&&c!=10&&c!=13){break} start=start+1 } var end=n; while(end>start){ var c=s.charAt(end-1); if(c!=32&&c!=9&&c!=10&&c!=13){break} end=end-1 } return s.substring(start,end) }
indexOf(String s, String needle): Int { if(needle.length==0){return 0} var n=s.length; var m=needle.length; if(m>n){return -1} var limit=n-m; var i=0; while(i<=limit){ var match=1; var j=0; while(j<m){ if(s.charAt(i+j)!=needle.charAt(j)){match=0; j=m} else{j=j+1} } if(match==1){return i} i=i+1 } return -1 }
htmlEscape(String s): String { var out=""; var i=0; while(i<s.length){ var c=s.charAt(i); if(c==38){out=out+"&amp;"} else if(c==60){out=out+"&lt;"} else if(c==62){out=out+"&gt;"} else{out=out+s.substring(i,i+1)} i=i+1 } return out }
record Customer(Int customer_id, String name, String city)
record Transaction(Int tx_id, Int customer_id, Double amount)
record Agg(String city, Int cnt, Double tot, Double mean)
loadCustomers(String p): List<Customer> { var raw=File(p).readText(); if(raw==null){throw "customers: cannot read "+p} var lines=split(raw,"\n"); var out=listOf<Customer>(); var i=0; while(i<lines.size()){ var l=trim(lines.get(i)); if(l.length>0){out.add(json.decode<Customer>(l))} i=i+1 } return out }
loadTransactions(String p): List<Transaction> { var raw=File(p).readText(); if(raw==null){throw "tx: cannot read "+p} var lines=split(raw,"\n"); var out=listOf<Transaction>(); var i=0; while(i<lines.size()){ var l=trim(lines.get(i)); if(l.length>0){out.add(json.decode<Transaction>(l))} i=i+1 } return out }
computeAgg(List<Transaction> txs, List<Customer> cs): List<Agg> { var names=listOf<String>(); var counts=listOf<Int>(); var sums=listOf<Double>(); var i=0; while(i<txs.size()){ var t=txs.get(i); var city=""; var j=0; while(j<cs.size()){ if(cs.get(j).customer_id==t.customer_id){city=cs.get(j).city; j=cs.size()} else{j=j+1} } var idx=-1; var k=0; while(k<names.size()){ if(names.get(k)==city){idx=k; k=names.size()} else{k=k+1} } if(idx==-1){ names.add(city); counts.add(1); sums.add(t.amount) } else{ counts.set(idx, counts.get(idx)+1); sums.set(idx, sums.get(idx)+t.amount) } i=i+1 } var out=listOf<Agg>(); var b=0; while(b<names.size()){ var c=counts.get(b); var tot=sums.get(b); var mu=tot/(1.0*c); out.add(Agg(names.get(b),c,tot,mu)); b=b+1 } return out }
buildHtml(List<Agg> aggs, String irisSummary): String { var rows=""; var i=0; while(i<aggs.size()){ var a=aggs.get(i); rows=rows+"<tr><td>"+htmlEscape(a.city)+"</td><td>"+a.cnt.toString()+"</td><td>"+a.tot.toString()+"</td><td>"+a.mean.toString()+"</td></tr>\n"; i=i+1 } var js="["; var j=0; while(j<aggs.size()){ var a2=aggs.get(j); if(j>0){js=js+","} js=js+"{city:\""+a2.city+"\",total:"+a2.tot.toString()+"}"; j=j+1 } js=js+"]"; var html=""; html=html+"<!DOCTYPE html><html><head><meta charset=\"UTF-8\"/><title>Batch Pipeline Report</title><style>body{font-family:sans-serif;margin:24px} table{border-collapse:collapse} th,td{border:1px solid #999;padding:6px 10px} th{background:#eee}</style></head><body>\n"; html=html+"<h1>Batch Pipeline Report</h1>\n"; html=html+"<p>"+irisSummary+"</p>\n"; html=html+"<h2>Transactions by City</h2><table><thead><tr><th>City</th><th>Count</th><th>Total</th><th>Mean</th></tr></thead><tbody>\n"+rows+"</tbody></table>\n"; html=html+"<h2>Totals (Canvas)</h2><canvas id=\"chart\" width=\"500\" height=\"300\" style=\"border:1px solid #ccc\"></canvas>\n"; html=html+"<script>var data="+js+"; var c=document.getElementById('chart'); var ctx=c.getContext('2d'); var maxV=0; for(var i=0;i<data.length;i++){ if(data[i].total>maxV) maxV=data[i].total; } var pad=40; var w=c.width, h=c.height; var slot=(w-2*pad)/data.length; var barW=slot*0.6; ctx.strokeStyle='#000'; ctx.beginPath(); ctx.moveTo(pad,h-pad); ctx.lineTo(w-pad,h-pad); ctx.stroke(); for(var i=0;i<data.length;i++){ var bh=(data[i].total/maxV)*(h-2*pad); var x=pad+i*slot+slot*0.2; var y=h-pad-bh; ctx.fillStyle='#377eb8'; ctx.fillRect(x,y,barW,bh); ctx.fillStyle='#000'; ctx.font='11px sans-serif'; ctx.fillText(data[i].city, x+barW/2-10, h-15); }<\/script>\n"; html=html+"</body></html>\n"; return html }
loadIrisSummary(String path): String { var raw=File(path).readText(); if(raw==null){return "iris: cannot read"} var lines=split(raw,"\n"); var n=0; var i=1; while(i<lines.size()){ if(trim(lines.get(i)).length>0){n=n+1} i=i+1 } return "Iris dataset: "+n.toString()+" rows (iris.csv) + 150 rows (iris_full.csv) loaded for reference." }

test "pipeline agg 3 cities" { var cs=loadCustomers("datasets/customers.jsonl"); var txs=loadTransactions("datasets/transactions.jsonl"); var aggs=computeAgg(txs,cs); assert(aggs.size()==3,"3 cities") }
test "pipeline SP tot" { var cs=loadCustomers("datasets/customers.jsonl"); var txs=loadTransactions("datasets/transactions.jsonl"); var aggs=computeAgg(txs,cs); var found=0; var i=0; while(i<aggs.size()){ if(aggs.get(i).city=="SP"){ var d=aggs.get(i).tot-1416.24; if(d<0.0){d=-d} assert(d<0.01,"SP tot"); found=1 } i=i+1 } assert(found==1,"SP found") }
test "html contains table and canvas" { var cs=loadCustomers("datasets/customers.jsonl"); var txs=loadTransactions("datasets/transactions.jsonl"); var aggs=computeAgg(txs,cs); var html=buildHtml(aggs,"test"); assert(html.contains("<table"),"table"); assert(html.contains("<canvas"),"canvas") }
